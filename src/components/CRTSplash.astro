---
// CRTSplash.astro - Iconic Resident Evil (PS1) 3D Door Opening Loading Splash Screen
// Uses public/models/psx-door.glb. Pure visual 3D sequence as an atmospheric loading buffer.
// Runs strictly on initial session visit. Replay with Ctrl+F5 or Ctrl+R.
---

<div
  id="crt-splash-screen"
  class="fixed inset-0 z-[99999] bg-[#000000] flex items-center justify-center overflow-hidden select-none pointer-events-auto"
  style="position: fixed !important; top: 0 !important; left: 0 !important; width: 100vw !important; width: 100dvw !important; height: 100vh !important; height: 100dvh !important; background-color: #000000 !important; z-index: 9999999 !important; display: flex !important; align-items: center !important; justify-content: center !important; overflow: hidden !important; view-transition-name: none !important;"
  aria-hidden="true"
  role="presentation"
>
  <!-- Full-Screen Three.js WebGL Arena: Resident Evil 3D Door & Hallway -->
  <canvas
    id="re-door-canvas"
    class="absolute inset-0 w-full h-full block z-10 cursor-default"
  ></canvas>

  <!-- Dramatic Dark Vignette Overlay -->
  <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_center,transparent_35%,rgba(0,0,0,0.85)_75%,rgba(0,0,0,1)_100%)] z-20"></div>

  <!-- Subtle PS1 Dither & Scanline Texture Filter -->
  <div class="absolute inset-0 pointer-events-none crt-ps1-scanlines opacity-35 z-20"></div>

  <!-- Atmospheric Opaque Shroud & Threshold Fade Curtain -->
  <div
    id="re-fade-curtain"
    class="fixed inset-0 bg-[#000000] pointer-events-none opacity-100 z-30 transition-opacity duration-800 ease-out"
  ></div>
</div>

<style>
  .crt-ps1-scanlines {
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.45) 50%);
    background-size: 100% 3px;
  }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

  function runResidentEvilDoorSplash() {
    // Check if already opened in this session
    if (sessionStorage.getItem('portfolio_door_opened') === 'true' || sessionStorage.getItem('portfolio_crt_booted') === 'true') {
      const splash = document.getElementById('crt-splash-screen');
      if (splash) splash.remove();
      return;
    }

    const splash = document.getElementById('crt-splash-screen');
    const canvas = document.getElementById('re-door-canvas') as HTMLCanvasElement | null;
    const fadeCurtain = document.getElementById('re-fade-curtain');

    if (!splash || !canvas) return;

    let isDone = false;
    let animId: number | null = null;
    let startTime = 0;

    // =========================================================================
    // Three.js Scene: Authentic Spencer Mansion Hallway & Full Door Framing
    // =========================================================================
    let width = window.innerWidth;
    let height = window.innerHeight;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x000000);
    // Subtle PS1 hallway depth fog
    scene.fog = new THREE.FogExp2(0x060406, 0.045);

    const camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 50);

    // Calculate optimal camera distance so the ENTIRE door and frame are 100% visible
    // Doorframe dimensions: Width = 0.90m, Height = 1.94m
    function getOptimalCameraZ(aspect: number): number {
      const fov = 40;
      const halfFovRad = (fov * Math.PI) / 360;
      const halfFovTan = Math.tan(halfFovRad);
      // Target: 2.50m height and 1.40m width ensures side walls and full door width fit
      const zByHeight = (2.50 / 2) / halfFovTan;
      const zByWidth = (1.40 / 2) / (halfFovTan * aspect);
      return Math.max(zByHeight, zByWidth, 3.4);
    }

    let startZ = getOptimalCameraZ(width / height);
    camera.position.set(0, 0, startZ);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: false, // PS1 authentic retro look
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Hallway Lighting: Flashlight Spotlight + Ambient Fill
    const ambientLight = new THREE.AmbientLight(0x1a1518, 0.55);
    scene.add(ambientLight);

    const fillLight = new THREE.PointLight(0x282025, 0.6, 9);
    fillLight.position.set(0, 0.6, 3.0);
    scene.add(fillLight);

    // Focused flashlight spotlight pointed at the door lock and center panel
    const spotLight = new THREE.SpotLight(0xffeed6, 0, 15, Math.PI / 4.2, 0.72, 1.2);
    spotLight.position.set(0.05, 0.1, 3.6);
    scene.add(spotLight);

    const spotTarget = new THREE.Object3D();
    spotTarget.position.set(-0.1, 0.0, 0.0);
    scene.add(spotTarget);
    spotLight.target = spotTarget;

    // Hallway Environment Group (Floor, Walls & Doorway)
    const hallwayGroup = new THREE.Group();
    scene.add(hallwayGroup);

    // Dark Hallway Floor at y = -0.97 (level with doorframe threshold)
    const floorMat = new THREE.MeshStandardMaterial({
      color: 0x100e0d,
      roughness: 0.85,
      metalness: 0.08,
    });
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(16, 16), floorMat);
    floor.rotation.x = -Math.PI / 2;
    floor.position.set(0, -0.97, 0);
    hallwayGroup.add(floor);

    // Mansion Hallway Walls around the doorframe
    const wallMat = new THREE.MeshStandardMaterial({
      color: 0x141113,
      roughness: 0.92,
      metalness: 0.05,
    });

    // Left wall
    const leftWall = new THREE.Mesh(new THREE.PlaneGeometry(8, 5), wallMat);
    leftWall.position.set(-4.45, 0.5, -0.01);
    hallwayGroup.add(leftWall);

    // Right wall
    const rightWall = new THREE.Mesh(new THREE.PlaneGeometry(8, 5), wallMat);
    rightWall.position.set(4.45, 0.5, -0.01);
    hallwayGroup.add(rightWall);

    // Top header wall
    const topWall = new THREE.Mesh(new THREE.PlaneGeometry(0.90, 2.5), wallMat);
    topWall.position.set(0, 2.22, -0.01);
    hallwayGroup.add(topWall);

    // Baseboards along floor left and right
    const trimMat = new THREE.MeshStandardMaterial({
      color: 0x1c1514,
      roughness: 0.75,
      metalness: 0.1,
    });
    const leftTrim = new THREE.Mesh(new THREE.BoxGeometry(8, 0.14, 0.04), trimMat);
    leftTrim.position.set(-4.45, -0.90, 0.02);
    hallwayGroup.add(leftTrim);

    const rightTrim = new THREE.Mesh(new THREE.BoxGeometry(8, 0.14, 0.04), trimMat);
    rightTrim.position.set(4.45, -0.90, 0.02);
    hallwayGroup.add(rightTrim);

    // Dark interior void backdrop behind the door opening
    const backVoidMat = new THREE.MeshBasicMaterial({ color: 0x020203 });
    const backVoid = new THREE.Mesh(new THREE.PlaneGeometry(12, 8), backVoidMat);
    backVoid.position.set(0, 0.5, -3.5);
    hallwayGroup.add(backVoid);

    // Door 3D Group
    const doorGroup = new THREE.Group();
    scene.add(doorGroup);

    let doorNode: THREE.Object3D | null = null;
    let handleNode: THREE.Object3D | null = null;
    let initialRotZ = 0;
    let isModelLoaded = false;

    // Load psx-door.glb
    const loader = new GLTFLoader();
    loader.load(
      '/models/psx-door.glb',
      (gltf) => {
        const fullScene = gltf.scene;

        // Hide all extra doors and doorframes
        const extraNames = [
          'Worn_Door_001', 'Worn_Door_002', 'Worn_Door_004', 'Door_Handle009',
          'Worn_Door_005', 'Door_Handle008', 'Worn_Doorframe_004', 'Worn_Doorframe_005'
        ];
        extraNames.forEach((n) => {
          const obj = fullScene.getObjectByName(n);
          if (obj) obj.visible = false;
        });

        // Isolate Spencer Mansion dark wood door (Door 6 & Frame 6)
        const frame = fullScene.getObjectByName('Worn_Doorframe_006');
        doorNode = fullScene.getObjectByName('Worn_Door_006') || null;
        handleNode = fullScene.getObjectByName('Door_Handle005') || null;

        if (doorNode) {
          initialRotZ = doorNode.rotation.z;
        }

        // Center doorway exactly at (0, 0, 0)
        if (frame) {
          frame.updateMatrixWorld(true);
          const frameBox = new THREE.Box3().setFromObject(frame);
          const center = new THREE.Vector3();
          frameBox.getCenter(center);
          doorGroup.position.set(-center.x, -center.y, -center.z);
        }

        doorGroup.add(fullScene);
        isModelLoaded = true;
        startTime = performance.now();

        // Smoothly fade out the 0ms critical curtain as the 3D scene reveals
        const criticalCurtain = document.getElementById('critical-boot-curtain');
        if (criticalCurtain) {
          criticalCurtain.style.transition = 'opacity 0.4s ease-out';
          criticalCurtain.style.opacity = '0';
          setTimeout(() => {
            if (criticalCurtain.parentNode) criticalCurtain.remove();
          }, 450);
        }

        // Reveal the scene softly out of the opaque curtain ("poco a poco")
        if (fadeCurtain) {
          fadeCurtain.style.opacity = '0';
        }
      },
      undefined,
      (err) => {
        console.warn('Door model loading warning:', err);
      }
    );

    // =========================================================================
    // Master Animation Timeline (Resident Evil PS1 Loading Buffer)
    // - Total buffer: ~3.8s animation + ~0.5s fluid cross-fade = ~4.3s
    // - 0.0s - 0.85s: Soft fade-in from darkness ("poco a poco"), flashlight warm-up
    // - 0.85s - 1.20s: Lock clicks, handle depresses down and springs back
    // - 1.20s - 2.95s: Wooden door creaks open inward smoothly
    // - 1.80s - 3.40s: Camera glides forward through the open doorway
    // - 2.90s - 3.65s: Camera crosses threshold into dark interior void
    // - 3.70s - 4.30s: Smooth fluid cross-fade into fully loaded portfolio
    // =========================================================================
    function renderScene(time: number) {
      if (isDone) return;

      if (isModelLoaded && startTime > 0) {
        const elapsed = (time - startTime) / 1000;

        // Flashlight warm-up from 0.0s to 0.85s
        if (elapsed < 0.85) {
          spotLight.intensity = Math.min((elapsed / 0.85) * 5.6, 5.6);
        } else {
          // Subtle natural flashlight breathing
          spotLight.intensity = 5.6 + Math.sin(elapsed * 4.0) * 0.15;
        }

        // Camera handheld breathing before forward push
        if (elapsed < 1.80) {
          camera.position.x = Math.sin(elapsed * 1.6) * 0.012;
          camera.position.y = Math.cos(elapsed * 1.4) * 0.008;
        }

        // Step 1: Door handle depresses on latch click (0.85s to 1.20s)
        if (elapsed >= 0.85 && elapsed < 1.20 && handleNode) {
          const p = (elapsed - 0.85) / 0.35;
          const jiggle = Math.sin(p * Math.PI) * 0.22;
          handleNode.rotation.y = jiggle;
        }

        // Step 2: Wooden Door creaks open inward (1.20s to 2.95s)
        if (elapsed >= 1.20 && elapsed < 2.95 && doorNode) {
          const openProgress = Math.min((elapsed - 1.20) / 1.75, 1.0);
          // Cubic ease-in-out swing
          const easeSwing = openProgress < 0.5
            ? 4 * openProgress * openProgress * openProgress
            : 1 - Math.pow(-2 * openProgress + 2, 3) / 2;

          // Swing door open inward by ~83 degrees (-1.45 radians)
          doorNode.rotation.z = initialRotZ - easeSwing * 1.45;
        }

        // Step 3: Camera moves forward through the open doorway (1.80s to 3.40s)
        if (elapsed >= 1.80) {
          const camProgress = Math.min((elapsed - 1.80) / 1.60, 1.0);
          const easeCam = camProgress < 0.5
            ? 2 * camProgress * camProgress
            : 1 - Math.pow(-2 * camProgress + 2, 2) / 2;

          // Glides from startZ down to -0.40m (right through the open threshold)
          camera.position.z = startZ - easeCam * (startZ + 0.40);
          camera.position.x = Math.sin(camProgress * Math.PI) * 0.03;
          camera.position.y = -Math.sin(camProgress * Math.PI) * 0.02;
        }

        // Step 4: Soft opaque dissolve as camera crosses the threshold (2.90s to 3.65s)
        if (elapsed >= 2.90 && fadeCurtain) {
          fadeCurtain.style.opacity = '1';
        }

        // Step 5: Finish sequence at 3.75s and smoothly reveal the loaded portfolio
        if (elapsed >= 3.75) {
          finish();
          return;
        }
      }

      renderer.render(scene, camera);
      animId = requestAnimationFrame(renderScene);
    }

    // Start 3D Loop
    animId = requestAnimationFrame(renderScene);

    function finish() {
      if (isDone) return;
      isDone = true;
      if (animId) cancelAnimationFrame(animId);

      // Save session storage flags so it never re-runs in this session
      sessionStorage.setItem('portfolio_door_opened', 'true');
      sessionStorage.setItem('portfolio_crt_booted', 'true');
      document.documentElement.classList.add('crt-booted');

      // Apply saved theme (defaults to light mode) now that splash is done
      const theme = localStorage.getItem('portfolio-theme') || 'light';
      if (theme !== 'dark') {
        document.documentElement.classList.add('light-theme');
      }

      // Ensure critical curtain is cleanly removed
      const criticalCurtain = document.getElementById('critical-boot-curtain');
      if (criticalCurtain) criticalCurtain.remove();

      // Fluid, graceful dissolve revealing the fully loaded portfolio
      if (splash) {
        splash.style.transition = 'opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
        splash.style.opacity = '0';
        setTimeout(() => {
          if (splash.parentNode) splash.remove();
        }, 620);
      }
    }

    // Developer / testing hard refresh interceptor (Ctrl+F5 or Ctrl+R) to allow replay
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && (e.key === 'F5' || e.key === 'r' || e.key === 'R')) {
        sessionStorage.removeItem('portfolio_door_opened');
        sessionStorage.removeItem('portfolio_crt_booted');
      }
    });

    // Window Resize Handler (Recalculates optimal distance so door is never cropped)
    const onResize = () => {
      if (isDone) return;
      width = window.innerWidth;
      height = window.innerHeight;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      startZ = getOptimalCameraZ(width / height);
      renderer.setSize(width, height);
    };
    window.addEventListener('resize', onResize);
  }

  // Run on initial load
  runResidentEvilDoorSplash();

  document.addEventListener('astro:page-load', () => {
    if (sessionStorage.getItem('portfolio_door_opened') === 'true' || sessionStorage.getItem('portfolio_crt_booted') === 'true') {
      const splash = document.getElementById('crt-splash-screen');
      if (splash) splash.remove();
    }
  });
</script>
