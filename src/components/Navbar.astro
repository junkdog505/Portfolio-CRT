---
const pathname = Astro.url.pathname;

const navItems = [
  { name: 'Inicio', href: '/', id: '01' },
  { name: 'Sobre Mí', href: '/sobre-mi', id: '02' },
  { name: 'Formación', href: '/formacion', id: '03' },
  { name: 'Experiencia', href: '/experiencia', id: '04' },
  { name: 'Proyectos', href: '/proyectos', id: '05' },
  { name: 'Contacto', href: '/contacto', id: '06' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 pointer-events-none">
  <!-- Nav Shell: 100% width at top -> w-fit floating dock when sticky / scrolled -->
  <div class="w-full flex justify-center">
    <div
      id="navbar-shell"
      class="pointer-events-auto flex items-center relative z-20 [backdrop-filter:none]"
    >
      <!-- Corner L-Brackets for Shell -->
      <div class="tech-corner-tl"></div>
      <div class="tech-corner-tr"></div>
      <div class="tech-corner-bl"></div>
      <div class="tech-corner-br"></div>

      <!-- Pure Code Logo: Clean { ; } without outer boxes -->
      <a
        href="/"
        class="group flex items-center select-none py-1 transition-all shrink-0"
        title="Code Terminal Root // { ; }"
      >
        <svg
          class="h-6 sm:h-7 w-auto select-none overflow-visible filter drop-shadow-[0_0_8px_rgba(245,158,11,0.65)] group-hover:drop-shadow-[0_0_14px_rgba(251,191,36,0.95)] transition-all"
          viewBox="0 0 52 26"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <!-- Left Curly Brace { -->
          <path
            d="M14 4 H8 V8 H5 V11 H2 V15 H5 V18 H8 V22 H14 V19 H10 V15 H7 V11 H10 V7 H14 V4 Z"
            fill="#f59e0b"
            class="group-hover:fill-amber-300 transition-colors"
          />

          <!-- Center Semicolon ; in Phosphor Gold -->
          <g fill="#fbbf24" class="group-hover:fill-yellow-100 transition-colors">
            <!-- Upper Dot -->
            <rect x="24.5" y="7.5" width="3" height="3" rx="0.5" />
            <!-- Lower Dot + Comma Tail -->
            <rect x="24.5" y="13.5" width="3" height="3" rx="0.5" />
            <path d="M24.5 16.5 H27.5 L26 20.5 H23.5 L24.5 16.5 Z" />
          </g>

          <!-- Right Curly Brace } -->
          <path
            d="M38 4 H44 V8 H47 V11 H50 V15 H47 V18 H44 V22 H38 V19 H42 V15 H45 V11 H42 V7 H38 V4 Z"
            fill="#f59e0b"
            class="group-hover:fill-amber-300 transition-colors"
          />
        </svg>
      </a>

      <!-- Desktop Nav Links (Clean text, 0.3s smooth pulse ONLY on bottom line every 3s) -->
      <ul class="hidden md:flex items-center gap-4 lg:gap-8 font-mono text-[11px] lg:text-xs shrink-0">
        {navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <li>
              <a
                href={item.href}
                class={`group relative py-1.5 px-2 font-mono text-xs uppercase tracking-wider select-none block transition-colors duration-150 ${
                  active
                    ? 'text-amber-300 font-bold drop-shadow-[0_0_6px_rgba(245,158,11,0.6)]'
                    : 'text-zinc-400 hover:text-amber-200'
                }`}
              >
                <span class="flex items-center gap-1.5">
                  {active && (
                    <span class="text-amber-400 font-black text-[11px]">&gt;</span>
                  )}
                  <span class="relative z-10">{item.name}</span>
                </span>

                {/* Bottom Line: Procedural sweep for 0.6s every 3s when active */}
                <span
                  class={`absolute bottom-0 inset-x-0 h-[2px] rounded-full overflow-hidden transition-all duration-200 ${
                    active
                      ? 'active-bottom-line'
                      : 'bg-amber-400/80 scale-x-0 group-hover:scale-x-100 shadow-[0_0_8px_#f59e0b] origin-center'
                  }`}
                />
              </a>
            </li>
          );
        })}
      </ul>

      <!-- Mobile Button Container with Absolute 8-Bit Dropdown right below it -->
      <div class="relative md:hidden shrink-0">
        <button
          type="button"
          id="mobile-menu-btn"
          class="flex items-center justify-center gap-1.5 px-2.5 py-1 text-xs font-mono text-amber-400 border-2 border-amber-600 bg-black hover:border-amber-400 hover:text-amber-300 active:bg-amber-400 active:text-black select-none cursor-pointer min-w-[90px] h-7 shadow-[2px_2px_0_#000]"
          aria-label="Alternar menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu-dropdown"
        >
          <span class="inline-block w-1.5 h-1.5 bg-amber-400 animate-pulse"></span>
          <span id="mobile-menu-text" class="font-bold tracking-wider leading-none">[MENÚ ☰]</span>
        </button>

        <!-- 8-BIT CRT DROPDOWN MENU (Clean, flat, single-line items, anchored under button) -->
        <div
          id="mobile-menu-dropdown"
          class="hidden md:hidden absolute right-0 top-[calc(100%+6px)] w-48 sm:w-52 bg-[#050508] border-2 border-amber-500 shadow-[4px_4px_0_#000,0_0_16px_rgba(245,158,11,0.35)] p-1 font-mono text-xs z-50 select-none pointer-events-auto"
        >
          <div class="flex flex-col gap-0.5">
            {navItems.map((item) => {
              const active = isActive(item.href);
              return (
                <a
                  href={item.href}
                  data-route-link
                  class={`group flex items-center px-2.5 py-2 font-mono text-xs uppercase tracking-wider transition-none ${
                    active
                      ? 'bg-amber-400 text-black font-black'
                      : 'text-zinc-300 hover:bg-amber-400 hover:text-black active:bg-amber-300 active:text-black'
                  }`}
                >
                  <!-- 8-Bit Blinking Cursor ▶ -->
                  <span
                    class={`mr-2 font-mono text-xs leading-none shrink-0 ${
                      active
                        ? 'text-black inline-block animate-pulse'
                        : 'text-amber-400 opacity-0 group-hover:opacity-100 group-hover:text-black'
                    }`}
                  >
                    ▶
                  </span>

                  <!-- Route Number & Name (Flat, no extra clutter) -->
                  <span class="font-bold tracking-wider">{item.id}</span>
                  <span class={`mx-1 font-bold ${active ? 'text-black' : 'text-zinc-600 group-hover:text-black'}`}>.</span>
                  <span class="font-bold tracking-wider truncate">{item.name}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay (transparent dark, closes menu when clicking outside) -->
  <div
    id="mobile-menu-backdrop"
    class="fixed inset-0 bg-black/60 pointer-events-none opacity-0 transition-opacity duration-150 md:hidden z-10"
    aria-hidden="true"
  ></div>

  <!-- Mobile Rapid CRT Iris Expansion Wipe Layer (Executes exclusively on route click on mobile) -->
  <div
    id="mobile-route-wipe"
    class="fixed inset-0 bg-[#050508] pointer-events-none opacity-0 md:hidden z-[99999]"
    aria-hidden="true"
  >
    <!-- CRT Overlay & Expanding Center Feedback -->
    <div class="crt-overlay"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center font-mono select-none">
      <span class="text-amber-400 font-bold tracking-widest text-sm crt-text-amber animate-pulse">
        [ CARGANDO... ]
      </span>
      <span class="text-[10px] text-amber-600 mt-1 tracking-widest font-mono">
        // ACCEDIENDO AL SISTEMA
      </span>
    </div>
  </div>
</header>

<style>
  /* 0.3s Smooth Transition: The element distribution remains centered so elements DO NOT jump */
  #navbar-shell {
    transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                max-width 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                padding 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                margin-top 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.3s ease,
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }

  /* 1. TOP STATE (MOBILE < 768px): 100% width edge-to-edge, logo left & menu right */
  #navbar-shell:not(.is-sticky) {
    width: 100%;
    max-width: 100%;
    margin-top: 0;
    border-width: 0 0 1px 0;
    border-color: rgba(180, 83, 9, 0.4);
    background-color: rgba(8, 8, 12, 0.95);
    padding: 0.85rem 1.25rem;
    justify-content: space-between;
    box-shadow: none;
  }

  /* 1. TOP STATE (DESKTOP >= 768px): 100% full width background bar, elements centered */
  @media (min-width: 768px) {
    #navbar-shell:not(.is-sticky) {
      padding: 0.85rem 1.5rem;
      justify-content: center;
      gap: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    #navbar-shell:not(.is-sticky) {
      padding: 0.85rem 2.5rem;
      gap: 3rem;
    }
  }

  /* 2. STICKY STATE (MOBILE < 768px): Floating compact dock */
  #navbar-shell.is-sticky {
    width: 92vw;
    max-width: 440px;
    margin-top: 0.5rem;
    border-width: 1px;
    border-color: rgba(217, 119, 6, 0.3);
    background-color: #08080c;
    padding: 0.5rem 1rem;
    justify-content: space-between;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.95), 0 0 20px rgba(217, 119, 6, 0.2);
  }

  /* 2. STICKY STATE (DESKTOP >= 768px): Floating centered dock (w-fit). */
  @media (min-width: 768px) {
    #navbar-shell.is-sticky {
      width: -moz-fit-content;
      width: fit-content;
      max-width: calc(100vw - 2rem);
      margin-top: 0.75rem;
      border-width: 1px;
      border-color: rgba(217, 119, 6, 0.3);
      padding: 0.5rem 1.5rem;
      justify-content: center;
      gap: 1.75rem;
      box-shadow: 0 14px 40px rgba(0, 0, 0, 0.95), 0 0 22px rgba(217, 119, 6, 0.18);
    }
  }

  @media (min-width: 1024px) {
    #navbar-shell.is-sticky {
      gap: 3rem;
      padding: 0.5rem 2rem;
    }
  }

  /* ==========================================================================
     BACKDROP & MOBILE ROUTE WIPE ANIMATION
     ========================================================================== */
  #mobile-menu-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  #mobile-route-wipe {
    transition: opacity 0.12s ease-out;
    clip-path: circle(0% at var(--click-x, 90%) var(--click-y, 5%));
  }

  #mobile-route-wipe.is-active {
    opacity: 1;
    pointer-events: auto;
    animation: crt8BitExpand 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  #mobile-route-wipe.is-fading {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease-out;
  }

  @keyframes crt8BitExpand {
    0% {
      opacity: 0.8;
      clip-path: circle(0% at var(--click-x, 90%) var(--click-y, 5%));
    }
    100% {
      opacity: 1;
      clip-path: circle(160% at var(--click-x, 90%) var(--click-y, 5%));
    }
  }

  @media (min-width: 768px) {
    #mobile-route-wipe,
    #mobile-menu-backdrop,
    #mobile-menu-dropdown {
      display: none !important;
    }
  }

  /* Prominent, Distinct Corner L-Brackets for Shell */
  .tech-corner-tl {
    position: absolute;
    top: -2px;
    left: -2px;
    width: 10px;
    height: 10px;
    border-top: 2px solid #fbbf24;
    border-left: 2px solid #fbbf24;
    filter: drop-shadow(0 0 5px #f59e0b);
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .tech-corner-tr {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    border-top: 2px solid #fbbf24;
    border-right: 2px solid #fbbf24;
    filter: drop-shadow(0 0 5px #f59e0b);
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .tech-corner-bl {
    position: absolute;
    bottom: -2px;
    left: -2px;
    width: 10px;
    height: 10px;
    border-bottom: 2px solid #fbbf24;
    border-left: 2px solid #fbbf24;
    filter: drop-shadow(0 0 5px #f59e0b);
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .tech-corner-br {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 10px;
    height: 10px;
    border-bottom: 2px solid #fbbf24;
    border-right: 2px solid #fbbf24;
    filter: drop-shadow(0 0 5px #f59e0b);
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  /* Shell corner crosshairs only active in sticky floating dock mode (DIRECT children ONLY!) */
  #navbar-shell:not(.is-sticky) > .tech-corner-tl,
  #navbar-shell:not(.is-sticky) > .tech-corner-tr,
  #navbar-shell:not(.is-sticky) > .tech-corner-bl,
  #navbar-shell:not(.is-sticky) > .tech-corner-br {
    opacity: 0;
    visibility: hidden;
  }

  #navbar-shell.is-sticky > .tech-corner-tl,
  #navbar-shell.is-sticky > .tech-corner-tr,
  #navbar-shell.is-sticky > .tech-corner-bl,
  #navbar-shell.is-sticky > .tech-corner-br {
    opacity: 1;
    visibility: visible;
  }

  /* Active Link Bottom Line Base */
  .active-bottom-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 9999px;
    background-color: rgba(245, 158, 11, 0.4);
    box-shadow: 0 0 5px rgba(245, 158, 11, 0.3);
    overflow: hidden;
    animation: activeBaseLinePulse 3s ease-in-out infinite;
  }

  /* Procedural Traveling Laser Sweep: Smoothly sweeps across the line in 0.6s every 3s */
  .active-bottom-line::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 45%;
    left: -50%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(245, 158, 11, 0.6) 20%,
      #fffbeb 50%,
      #fbbf24 80%,
      transparent 100%
    );
    filter: drop-shadow(0 0 8px #fbbf24);
    animation: proceduralBeamSweep 3s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  }

  @keyframes proceduralBeamSweep {
    0%, 80% {
      left: -50%;
      opacity: 0;
    }
    81% {
      left: -45%;
      opacity: 1;
    }
    99% {
      left: 115%;
      opacity: 1;
    }
    100% {
      left: 125%;
      opacity: 0;
    }
  }

  @keyframes activeBaseLinePulse {
    0%, 78%, 100% {
      background-color: rgba(245, 158, 11, 0.4);
      box-shadow: 0 0 5px rgba(245, 158, 11, 0.3);
    }
    85%, 96% {
      background-color: rgba(245, 158, 11, 0.7);
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.55);
    }
  }
</style>

<script>
  let audioCtx: AudioContext | null = null;

  function getAudioCtx() {
    try {
      const AudioClass = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioClass) return null;
      if (!audioCtx || audioCtx.state === 'closed') {
        audioCtx = new AudioClass();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    } catch (e) {
      return null;
    }
  }

  // 8-Bit Chime for Menu Open (ascending)
  function play8BitOpen() {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      // Tone 1
      const osc1 = ctx.createOscillator();
      const gain1 = ctx.createGain();
      osc1.type = 'square';
      osc1.frequency.setValueAtTime(587.33, now); // D5
      gain1.gain.setValueAtTime(0.08, now);
      gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
      osc1.connect(gain1);
      gain1.connect(ctx.destination);
      osc1.start(now);
      osc1.stop(now + 0.04);

      // Tone 2
      const osc2 = ctx.createOscillator();
      const gain2 = ctx.createGain();
      osc2.type = 'square';
      osc2.frequency.setValueAtTime(880, now + 0.04); // A5
      gain2.gain.setValueAtTime(0.09, now + 0.04);
      gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
      osc2.connect(gain2);
      gain2.connect(ctx.destination);
      osc2.start(now + 0.04);
      osc2.stop(now + 0.09);
    } catch (e) {}
  }

  // 8-Bit Sound for Menu Close (descending)
  function play8BitClose() {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'square';
      osc.frequency.setValueAtTime(659.25, now); // E5
      osc.frequency.setValueAtTime(440, now + 0.035); // A4
      gain.gain.setValueAtTime(0.07, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(now);
      osc.stop(now + 0.07);
    } catch (e) {}
  }

  // 8-Bit Rapid Select Sound for Route Click
  function play8BitSelect() {
    const ctx = getAudioCtx();
    if (!ctx) return;
    try {
      const now = ctx.currentTime;
      const osc1 = ctx.createOscillator();
      const gain1 = ctx.createGain();
      osc1.type = 'square';
      osc1.frequency.setValueAtTime(880, now); // A5
      gain1.gain.setValueAtTime(0.1, now);
      gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
      osc1.connect(gain1);
      gain1.connect(ctx.destination);
      osc1.start(now);
      osc1.stop(now + 0.04);

      const osc2 = ctx.createOscillator();
      const gain2 = ctx.createGain();
      osc2.type = 'square';
      osc2.frequency.setValueAtTime(1318.51, now + 0.035); // E6
      gain2.gain.setValueAtTime(0.12, now + 0.035);
      gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.11);
      osc2.connect(gain2);
      gain2.connect(ctx.destination);
      osc2.start(now + 0.035);
      osc2.stop(now + 0.11);
    } catch (e) {}
  }

  function setupNavbar() {
    const shell = document.getElementById('navbar-shell');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu-dropdown');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const menuText = document.getElementById('mobile-menu-text');
    const wipe = document.getElementById('mobile-route-wipe');

    // Reset wipe if it was active from previous page transition
    if (wipe && wipe.classList.contains('is-active')) {
      wipe.classList.add('is-fading');
      setTimeout(() => {
        wipe.classList.remove('is-active', 'is-fading');
      }, 150);
    }

    let isOpen = false;

    function toggleMenu(open?: boolean) {
      isOpen = open !== undefined ? open : !isOpen;
      btn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

      if (isOpen) {
        menu?.classList.remove('hidden');
        backdrop?.classList.add('is-open');
        if (menuText) menuText.textContent = '[CERRAR ✕]';
        play8BitOpen();
      } else {
        menu?.classList.add('hidden');
        backdrop?.classList.remove('is-open');
        if (menuText) menuText.textContent = '[MENÚ ☰]';
        play8BitClose();
      }
    }

    // 1. Sticky / Top transition handler
    function handleScroll() {
      if (!shell) return;
      const isScrolled = window.scrollY > 20;
      shell.classList.toggle('is-sticky', isScrolled);
      if (isOpen) {
        toggleMenu(false);
      }
    }

    window.removeEventListener('scroll', handleScroll);
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // 2. Mobile Menu interactions
    if (!btn || !menu) return;

    btn.onclick = (e) => {
      e.stopPropagation();
      toggleMenu();
    };

    if (backdrop) {
      backdrop.onclick = (e) => {
        e.stopPropagation();
        toggleMenu(false);
      };
    }

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (isOpen && !menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggleMenu(false);
      }
    });

    // 3. Route link click with rapid 8-bit expansion on mobile
    const routeLinks = menu.querySelectorAll<HTMLAnchorElement>('a[data-route-link]');
    routeLinks.forEach((link) => {
      link.addEventListener('click', () => {
        // Desktop uses standard behavior
        if (window.innerWidth >= 768) return;

        // If clicking current page, just close menu
        const currentPath = window.location.pathname;
        const targetHref = link.getAttribute('href') || '';
        const isCurrent = targetHref === '/' ? currentPath === '/' : currentPath.startsWith(targetHref);
        if (isCurrent) {
          toggleMenu(false);
          return;
        }

        // Rapid 8-bit sound
        play8BitSelect();

        // Calculate click coordinates for circular expansion wipe
        const rect = link.getBoundingClientRect();
        const clickX = `${rect.left + rect.width / 2}px`;
        const clickY = `${rect.top + rect.height / 2}px`;

        if (wipe) {
          wipe.style.setProperty('--click-x', clickX);
          wipe.style.setProperty('--click-y', clickY);
          wipe.classList.remove('is-fading');
          wipe.classList.add('is-active');

          // Fallback safety timeout in case page load doesn't trigger
          setTimeout(() => {
            if (wipe.classList.contains('is-active')) {
              wipe.classList.add('is-fading');
              setTimeout(() => {
                wipe.classList.remove('is-active', 'is-fading');
              }, 150);
            }
          }, 1500);
        }

        toggleMenu(false);
      });
    });
  }

  // Setup on initial load and View Transitions
  document.addEventListener('astro:page-load', setupNavbar);
</script>
