---
const pathname = Astro.url.pathname;

const navItems = [
  { name: 'Inicio', href: '/' },
  { name: 'Sobre Mí', href: '/sobre-mi' },
  { name: 'Formación', href: '/formacion' },
  { name: 'Experiencia', href: '/experiencia' },
  { name: 'Proyectos', href: '/proyectos' },
  { name: 'Contacto', href: '/contacto' },
];

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="fixed top-0 left-0 right-0 z-40 flex flex-col items-center p-2.5 sm:p-3 pointer-events-none">
  <!-- Top Status Telemetry Indicator -->
  <div class="w-full max-w-5xl mb-1.5 flex items-center justify-between text-[11px] font-mono text-zinc-400 px-3 select-none">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-zinc-200 font-bold tracking-wider crt-text-green">SYS: EN LÍNEA // DISPONIBLE</span>
    </div>
    <div class="hidden sm:flex items-center gap-3 text-zinc-500 text-[10px]">
      <span class="text-amber-500 crt-text-amber font-mono">&gt;_ FULL-STACK & 3D CREATIVE</span>
      <span>•</span>
      <span class="text-zinc-400 font-mono">60 FPS // RETRO CRT</span>
    </div>
  </div>

  <!-- Industrial Rust Navigation Bar with Transparency & Corner Crosshairs -->
  <nav class="pointer-events-auto relative flex items-center gap-1 border border-amber-900/60 bg-[#0c0c10]/80 px-3 py-1.5 shadow-[0_8px_32px_rgba(0,0,0,0.45)] backdrop-blur-md">
    <!-- Corner crosshair reticles -->
    <div class="tech-corner-tl"></div>
    <div class="tech-corner-tr"></div>
    <div class="tech-corner-bl"></div>
    <div class="tech-corner-br"></div>

    <a href="/" class="mr-2 sm:mr-3 flex items-center gap-2 border-r border-amber-900/50 pr-2.5 sm:pr-3 text-amber-500 hover:text-amber-400 transition-colors">
      <!-- Mini Terminal Prompt SVG Icon -->
      <svg class="w-4 h-4 text-amber-500 crt-text-amber" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
        <polyline points="4 17 10 11 4 5"></polyline>
        <line x1="12" y1="19" x2="20" y2="19"></line>
      </svg>
      <span class="text-xs font-bold tracking-wider crt-text-amber font-mono">PORTFOLIO</span>
    </a>

    <ul class="flex items-center gap-1 overflow-x-auto py-0.5 no-scrollbar">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <li>
            <a
              href={item.href}
              class={`px-2.5 sm:px-3 py-1 text-xs font-mono tracking-wider transition-all duration-150 block whitespace-nowrap ${
                active
                  ? 'bg-amber-600 text-black font-bold shadow-[0_0_10px_rgba(217,119,6,0.6)]'
                  : 'text-zinc-400 hover:text-amber-300 hover:bg-amber-950/20'
              }`}
            >
              {item.name}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Separator -->
    <div class="h-4 w-px bg-amber-900/50 mx-1 sm:mx-1.5 hidden sm:block"></div>

    <!-- Theme Toggle Switch (Dark / Light Mode) -->
    <button
      id="theme-toggle-btn"
      type="button"
      class="crt-btn text-xs py-1 px-2.5 ml-1 border-amber-600/70 select-none flex items-center gap-1.5"
      title="Alternar entre Modo Oscuro y Modo Claro"
      aria-label="Alternar modo oscuro y modo claro"
    >
      <span id="theme-icon">☀️</span>
      <span id="theme-label" class="text-[10px] font-bold hidden sm:inline">CLARO</span>
    </button>
  </nav>
</header>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    const icon = document.getElementById('theme-icon');
    const label = document.getElementById('theme-label');

    function syncState() {
      const isLight = document.documentElement.classList.contains('light-theme');
      if (icon) icon.textContent = isLight ? '☀️' : '🌙';
      if (label) label.textContent = isLight ? 'CLARO' : 'OSCURO';
    }

    syncState();

    if (btn) {
      btn.onclick = () => {
        const isNowLight = document.documentElement.classList.toggle('light-theme');
        localStorage.setItem('portfolio-theme', isNowLight ? 'light' : 'dark');
        syncState();

        // Mechanical switch click sound FX
        try {
          const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(isNowLight ? 880 : 440, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(140, ctx.currentTime + 0.05);
          gain.gain.setValueAtTime(0.3, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.05);
        } catch (e) {}
      };
    }
  }

  // Support Astro View Transitions
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
