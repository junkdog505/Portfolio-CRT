---
// Componente 3D interactivo de Tux con estética fiel a Nintendo 64 / Retro Low-Poly
---

<div class="relative w-full max-w-md mx-auto aspect-square flex items-center justify-center select-none">
  <!-- Interactive speech bubble -->
  <div id="tux-bubble" class="absolute -top-3 sm:top-2 left-1/2 -translate-x-1/2 z-20 px-4 py-1.5 rounded-full bg-zinc-900/95 border border-amber-500/40 text-xs font-semibold text-amber-200 shadow-2xl backdrop-blur-md transition-all duration-300 pointer-events-none text-center whitespace-nowrap">
    🐧 ¡Tux N64 Edition! Haz clic en mí
  </div>

  <!-- Canvas for Three.js (z-10 ensures it renders cleanly above background shadows) -->
  <canvas id="tux-canvas" class="relative z-10 w-full h-full cursor-grab active:cursor-grabbing rounded-3xl" title="Arrastra o haz clic para interactuar con Tux"></canvas>
  
  <!-- Subtle floor shadow strictly beneath feet -->
  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-48 h-6 bg-black/40 blur-lg rounded-full pointer-events-none z-0"></div>
</div>

<script>
  import * as THREE from 'three';

  let animationFrameId: number;
  let renderer: THREE.WebGLRenderer | null = null;

  function initTuxScene() {
    const canvas = document.getElementById('tux-canvas') as HTMLCanvasElement;
    const bubble = document.getElementById('tux-bubble');
    if (!canvas) return;

    if (renderer) {
      renderer.dispose();
      cancelAnimationFrame(animationFrameId);
    }

    const container = canvas.parentElement;
    const width = container ? container.clientWidth : 420;
    const height = container ? container.clientHeight : 420;

    // 1. Scene & Camera
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, width / height, 0.1, 50);
    camera.position.set(0, 0.25, 4.8);

    renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: false, // Authentic pixelated N64 feel
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. Nintendo 64 Lighting (Ambient + Warm Directional Key)
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.3);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0xfff7ed, 2.2);
    keyLight.position.set(2.5, 4, 3.5);
    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(0x93c5fd, 0.8);
    fillLight.position.set(-3, 0, 2);
    scene.add(fillLight);

    // 3. Create Authentic N64 Pixelated Texture
    function createN64TuxTexture(): THREE.CanvasTexture {
      const texCanvas = document.createElement('canvas');
      texCanvas.width = 128;
      texCanvas.height = 128;
      const ctx = texCanvas.getContext('2d')!;

      // Base black plumage with subtle N64 dithering
      ctx.fillStyle = '#181820';
      ctx.fillRect(0, 0, 128, 128);

      // Subtle noise
      for (let i = 0; i < 200; i++) {
        const nx = Math.floor(Math.random() * 128);
        const ny = Math.floor(Math.random() * 128);
        ctx.fillStyle = Math.random() > 0.5 ? '#1f1f28' : '#121217';
        ctx.fillRect(nx, ny, 2, 2);
      }

      // White Belly Oval (Center at X=64, bottom-middle)
      ctx.fillStyle = '#f0f0f5';
      ctx.beginPath();
      ctx.ellipse(64, 82, 26, 36, 0, 0, Math.PI * 2);
      ctx.fill();

      // Dithered edge for authentic N64 texture look
      ctx.strokeStyle = '#9ca3af';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Left Eye Oval
      ctx.fillStyle = '#f8fafc';
      ctx.beginPath();
      ctx.ellipse(54, 34, 7, 11, -0.05, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#0f172a';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Left Pupil
      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.ellipse(55, 34, 3.5, 6, 0, 0, Math.PI * 2);
      ctx.fill();

      // Left Glint
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(53, 31, 2, 2);

      // Right Eye Oval
      ctx.fillStyle = '#f8fafc';
      ctx.beginPath();
      ctx.ellipse(74, 34, 7, 11, 0.05, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#0f172a';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Right Pupil
      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.ellipse(73, 34, 3.5, 6, 0, 0, Math.PI * 2);
      ctx.fill();

      // Right Glint
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(72, 31, 2, 2);

      const texture = new THREE.CanvasTexture(texCanvas);
      texture.magFilter = THREE.NearestFilter; // Crucial for pixelated N64 look
      texture.minFilter = THREE.NearestFilter;
      texture.wrapS = THREE.RepeatWrapping;
      texture.wrapT = THREE.ClampToEdgeWrapping;
      return texture;
    }

    const tuxTexture = createN64TuxTexture();

    // 4. Authentic N64 Teardrop / Pear Body Geometry
    const tuxGroup = new THREE.Group();
    scene.add(tuxGroup);

    // Profile curve for low-poly pear shape (matching reference image)
    const points: THREE.Vector2[] = [];
    points.push(new THREE.Vector2(0, -1.05));       // Base center
    points.push(new THREE.Vector2(0.65, -1.02));    // Base bottom rim
    points.push(new THREE.Vector2(1.15, -0.75));    // Lower belly
    points.push(new THREE.Vector2(1.30, -0.30));    // Widest belly
    points.push(new THREE.Vector2(1.22, 0.15));     // Upper belly
    points.push(new THREE.Vector2(0.95, 0.60));     // Chest / neck transition
    points.push(new THREE.Vector2(0.78, 0.95));     // Head base
    points.push(new THREE.Vector2(0.70, 1.25));     // Forehead / eyes height
    points.push(new THREE.Vector2(0.42, 1.50));     // Head dome
    points.push(new THREE.Vector2(0, 1.55));        // Head crown top

    // 10 radial segments for exact N64 low-poly facet count
    const bodyGeo = new THREE.LatheGeometry(points, 10, -Math.PI, Math.PI * 2);

    const bodyMat = new THREE.MeshLambertMaterial({
      map: tuxTexture,
      flatShading: true, // Distinct N64 faceted polygon shading
    });

    const bodyMesh = new THREE.Mesh(bodyGeo, bodyMat);
    tuxGroup.add(bodyMesh);

    // 5. Beak Texture & Geometry (Flat trapezoidal low-poly beak directly under eyes)
    function createBeakTexture(): THREE.CanvasTexture {
      const bCanvas = document.createElement('canvas');
      bCanvas.width = 64;
      bCanvas.height = 64;
      const bctx = bCanvas.getContext('2d')!;

      bctx.fillStyle = '#d97706'; // Dark amber edge
      bctx.fillRect(0, 0, 64, 64);

      bctx.fillStyle = '#eab308'; // Golden yellow center
      bctx.fillRect(4, 4, 56, 56);

      // Noise
      for (let i = 0; i < 50; i++) {
        bctx.fillStyle = Math.random() > 0.5 ? '#f59e0b' : '#ca8a04';
        bctx.fillRect(Math.random() * 60, Math.random() * 60, 3, 3);
      }

      const bTex = new THREE.CanvasTexture(bCanvas);
      bTex.magFilter = THREE.NearestFilter;
      bTex.minFilter = THREE.NearestFilter;
      return bTex;
    }

    const beakTexture = createBeakTexture();
    const beakMat = new THREE.MeshLambertMaterial({
      map: beakTexture,
      flatShading: true,
    });

    const beakGeo = new THREE.ConeGeometry(0.58, 0.85, 4);
    const beakMesh = new THREE.Mesh(beakGeo, beakMat);
    beakMesh.rotation.x = Math.PI / 2 + 0.18;
    beakMesh.rotation.z = Math.PI / 4;
    beakMesh.scale.set(1.25, 0.7, 0.35);
    beakMesh.position.set(0, 0.90, 0.82);
    tuxGroup.add(beakMesh);

    // 6. Flippers / Wings (Low-poly flat wedges)
    const wingMat = new THREE.MeshLambertMaterial({
      color: 0x181820,
      flatShading: true,
    });

    const leftWingGroup = new THREE.Group();
    leftWingGroup.position.set(-1.05, 0.35, 0);
    const wingGeo = new THREE.BoxGeometry(0.12, 1.25, 0.55);
    const leftWingMesh = new THREE.Mesh(wingGeo, wingMat);
    leftWingMesh.position.set(0, -0.5, 0);
    leftWingMesh.rotation.z = -0.15;
    leftWingMesh.rotation.y = 0.2;
    leftWingGroup.add(leftWingMesh);
    tuxGroup.add(leftWingGroup);

    const rightWingGroup = new THREE.Group();
    rightWingGroup.position.set(1.05, 0.35, 0);
    const rightWingMesh = new THREE.Mesh(wingGeo, wingMat);
    rightWingMesh.position.set(0, -0.5, 0);
    rightWingMesh.rotation.z = 0.15;
    rightWingMesh.rotation.y = -0.2;
    rightWingGroup.add(rightWingMesh);
    tuxGroup.add(rightWingGroup);

    // 7. Feet (Flat polygonal flaps matching reference image)
    const feetMat = new THREE.MeshLambertMaterial({
      color: 0xd4a017, // Warm mustard yellow from reference
      flatShading: true,
    });

    const footShape = new THREE.Shape();
    footShape.moveTo(-0.35, -0.4);
    footShape.lineTo(0.35, -0.4);
    footShape.lineTo(0.55, 0.7);
    footShape.lineTo(0.0, 0.9);
    footShape.lineTo(-0.55, 0.7);
    footShape.closePath();

    const footGeo = new THREE.ExtrudeGeometry(footShape, {
      depth: 0.06,
      bevelEnabled: false,
    });

    const leftFoot = new THREE.Mesh(footGeo, feetMat);
    leftFoot.rotation.x = Math.PI / 2;
    leftFoot.rotation.z = -0.3;
    leftFoot.position.set(-0.5, -1.02, 0.35);
    tuxGroup.add(leftFoot);

    const rightFoot = new THREE.Mesh(footGeo, feetMat);
    rightFoot.rotation.x = Math.PI / 2;
    rightFoot.rotation.z = 0.3;
    rightFoot.position.set(0.5, -1.02, 0.35);
    tuxGroup.add(rightFoot);

    // Group position
    tuxGroup.position.y = -0.1;

    // 8. Interaction State & Mouse Handling
    const targetRotation = { x: 0, y: 0 };
    let isDragging = false;
    let previousMousePosition = { x: 0, y: 0 };
    let spinVelocity = 0;
    let jumpProgress = 0;
    let isJumping = false;

    const phrases = [
      '🐧 ¡N64 Retro Tux!',
      '🎮 Low-Poly Nostalgia',
      '✨ Desarrollador Frontend & 3D',
      '⚡ Three.js + Astro',
      '🔥 ¡Viva el Código Abierto!',
    ];
    let phraseIndex = 0;

    function triggerJump() {
      if (isJumping) return;
      isJumping = true;
      jumpProgress = 0;
      spinVelocity = Math.PI * 2.2;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      if (bubble) {
        bubble.textContent = phrases[phraseIndex];
        bubble.classList.add('scale-110', 'border-amber-400');
        setTimeout(() => bubble.classList.remove('scale-110', 'border-amber-400'), 400);
      }
    }

    canvas.addEventListener('pointerdown', (e) => {
      isDragging = true;
      previousMousePosition = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('pointermove', (e) => {
      if (isDragging) {
        const deltaX = e.clientX - previousMousePosition.x;
        const deltaY = e.clientY - previousMousePosition.y;
        tuxGroup.rotation.y += deltaX * 0.015;
        tuxGroup.rotation.x += deltaY * 0.01;
        tuxGroup.rotation.x = Math.max(-0.4, Math.min(0.4, tuxGroup.rotation.x));
        previousMousePosition = { x: e.clientX, y: e.clientY };
      } else {
        const rect = canvas.getBoundingClientRect();
        const normX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        const normY = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
        if (normX >= -1.6 && normX <= 1.6 && normY >= -1.6 && normY <= 1.6) {
          targetRotation.y = normX * 0.5;
          targetRotation.x = -normY * 0.25;
        }
      }
    });

    window.addEventListener('pointerup', () => {
      isDragging = false;
    });

    canvas.addEventListener('click', () => {
      triggerJump();
    });

    // 9. Retro N64 Animation Loop
    let startTime = performance.now();

    function animate(currentTime: number) {
      animationFrameId = requestAnimationFrame(animate);
      const elapsedTime = (currentTime - startTime) * 0.001;

      // Smooth tracking lerp
      if (!isDragging) {
        tuxGroup.rotation.y += (targetRotation.y - tuxGroup.rotation.y) * 0.07;
        tuxGroup.rotation.x += (targetRotation.x - tuxGroup.rotation.x) * 0.07;
      }

      // 360 Spin on jump
      if (spinVelocity > 0.01) {
        tuxGroup.rotation.y += spinVelocity * 0.1;
        spinVelocity *= 0.92;
      }

      // Idle waddle & bobbing
      if (!isJumping) {
        tuxGroup.position.y = -0.1 + Math.sin(elapsedTime * 2.4) * 0.05;
        tuxGroup.rotation.z = Math.sin(elapsedTime * 2.4) * 0.04; // Gentle penguin waddle
        leftWingGroup.rotation.z = Math.sin(elapsedTime * 2.4) * 0.1 - 0.15;
        rightWingGroup.rotation.z = -Math.sin(elapsedTime * 2.4) * 0.1 + 0.15;
      } else {
        jumpProgress += 0.055;
        tuxGroup.position.y = -0.1 + Math.sin(jumpProgress * Math.PI) * 0.45;
        leftWingGroup.rotation.z = -0.7 + Math.sin(jumpProgress * 16) * 0.35;
        rightWingGroup.rotation.z = 0.7 - Math.sin(jumpProgress * 16) * 0.35;

        if (jumpProgress >= 1) {
          isJumping = false;
          jumpProgress = 0;
        }
      }

      renderer?.render(scene, camera);
    }

    animate(performance.now());

    // 10. Resize Observer
    const resizeObserver = new ResizeObserver(() => {
      if (!container || !renderer) return;
      const newWidth = container.clientWidth;
      const newHeight = container.clientHeight;
      camera.aspect = newWidth / newHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(newWidth, newHeight);
    });

    resizeObserver.observe(container);
  }

  document.addEventListener('astro:page-load', () => {
    initTuxScene();
  });

  document.addEventListener('astro:before-swap', () => {
    if (animationFrameId) cancelAnimationFrame(animationFrameId);
    if (renderer) renderer.dispose();
  });
</script>
