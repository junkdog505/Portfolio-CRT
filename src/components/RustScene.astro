    const forkL = new THREE.Mesh(forkGeo, copperMat);
    forkL.position.set(-0.45, 0.27, -0.42);
    phoneInner.add(forkL);

    const forkR = new THREE.Mesh(forkGeo, copperMat);
    forkR.position.set(0.45, 0.27, -0.42);
    phoneInner.add(forkR);

    // Auricular
    const handsetGroup = new THREE.Group();
    handsetGroup.position.set(0, 0.4, -0.42);
    handsetGroup.rotation.z = 0.08;

    const hBarGeo = new THREE.CylinderGeometry(0.075, 0.075, 1.3, 6);
    const hBar = new THREE.Mesh(hBarGeo, darkMetalMat);
    hBar.rotation.z = Math.PI / 2;
    handsetGroup.add(hBar);

    const cupGeo = new THREE.CylinderGeometry(0.25, 0.2, 0.28, 10);
    const cupL = new THREE.Mesh(cupGeo, darkMetalMat);
    cupL.position.set(-0.65, 0, 0);
