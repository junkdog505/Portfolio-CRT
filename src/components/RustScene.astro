  function createRotaryDialMaterial(): THREE.MeshBasicMaterial {
    const c = document.createElement('canvas');
    c.width = 128;
    c.height = 128;
    const ctx = c.getContext('2d')!;

    ctx.fillStyle = '#f8fafc';
    ctx.fillRect(0, 0, 128, 128);

    ctx.strokeStyle = '#0f172a';
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.arc(64, 64, 58, 0, Math.PI * 2);
    ctx.stroke();

    ctx.fillStyle = '#0f172a';
    for (let i = 0; i < 10; i++) {
      const angle = (i / 10) * Math.PI * 1.6 + 0.3;
      const x = 64 + Math.cos(angle) * 38;
      const y = 64 + Math.sin(angle) * 38;
      ctx.beginPath();
      ctx.arc(x, y, 9, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 9px monospace';
      ctx.fillText(i.toString(), x - 3, y + 3);
      ctx.fillStyle = '#0f172a';
    }

    const tex = new THREE.CanvasTexture(c);
    tex.magFilter = THREE.NearestFilter;
    return new THREE.MeshBasicMaterial({ map: tex });
  }

  function createRustedMetalMaterial(): THREE.MeshLambertMaterial {
    const c = document.createElement('canvas');
    c.width = 128;
    c.height = 128;
    const ctx = c.getContext('2d')!;

    // Steel base with good mid-tone brightness
    ctx.fillStyle = '#4b4b54';
    ctx.fillRect(0, 0, 128, 128);

    // Warm rust and oxide corrosion patches
    ctx.fillStyle = '#b45309';
    ctx.beginPath();
    ctx.arc(35, 45, 30, 0, Math.PI * 2);
    ctx.arc(95, 85, 36, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#d97706';
    ctx.beginPath();
    ctx.arc(40, 50, 20, 0, Math.PI * 2);
    ctx.arc(90, 80, 22, 0, Math.PI * 2);
    ctx.fill();

    // Speckled pitting and metallic grain
    for (let i = 0; i < 350; i++) {
      ctx.fillStyle = Math.random() > 0.5 ? '#f59e0b' : (Math.random() > 0.3 ? '#27272a' : '#71717a');
      ctx.fillRect(Math.random() * 128, Math.random() * 128, 2, 2);
    }

    const tex = new THREE.CanvasTexture(c);
    tex.magFilter = THREE.NearestFilter;
    return new THREE.MeshLambertMaterial({
      map: tex,
      flatShading: true,
    });
  }

