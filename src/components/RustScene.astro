---
// Persistent Three.js Canvas for Rustpunk / PSX Lo-Fi 3D across Astro View Transitions
---

<div id="rust-3d-root" transition:persist="rust-3d-canvas" class="pointer-events-none fixed inset-0 z-30 overflow-hidden" style="view-transition-name: none !important;">
  <canvas id="rust-canvas" class="pointer-events-none h-full w-full block" style="view-transition-name: none !important;"></canvas>
  
  <!-- Subtle Audio/Glitch Indicator -->
  <div id="glitch-notify" class="pointer-events-none absolute bottom-5 left-5 z-40 hidden rounded border border-amber-600/50 bg-black/90 px-3 py-1 font-mono text-[11px] text-amber-400 backdrop-blur">
    <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse mr-1.5"></span>
    <span id="glitch-text">SISTEMA CONECTADO</span>
  </div>
</div>

<script>
  import * as THREE from 'three';

  // Global persistent state across View Transitions
  let scene: THREE.Scene;
  let camera: THREE.PerspectiveCamera;
  let renderer: THREE.WebGLRenderer;
  let animationFrameId: number;

  // Web Audio Context for Procedural Retro Sound FX on Click
  let audioCtx: AudioContext | null = null;

  function getAudioContext(): AudioContext {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playPropSound(propKey: string) {
    try {
      const ctx = getAudioContext();
      const now = ctx.currentTime;

      if (propKey === 'laptop') {
        // =====================================================================
        // 1. LAPTOP: Sonido de teclado mecánico (2 pulsaciones rápidas "clack-clack")
        // =====================================================================
        const strokeTimes = [now, now + 0.065];
        strokeTimes.forEach((t) => {
          // Impacto plástico/resorte
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(650 + Math.random() * 150, t);
          osc.frequency.exponentialRampToValueAtTime(180, t + 0.035);
          gain.gain.setValueAtTime(0.4, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.04);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.04);

          // Clic agudo de interruptor mecánico (Cherry MX / Model M)
          const clickOsc = ctx.createOscillator();
          const clickGain = ctx.createGain();
          clickOsc.type = 'square';
          clickOsc.frequency.setValueAtTime(2400 + Math.random() * 300, t);
          clickGain.gain.setValueAtTime(0.2, t);
          clickGain.gain.exponentialRampToValueAtTime(0.001, t + 0.015);
          clickOsc.connect(clickGain);
          clickGain.connect(ctx.destination);
          clickOsc.start(t);
          clickOsc.stop(t + 0.015);
        });

      } else if (propKey === 'radio') {
        // =====================================================================
        // 2. RADIO: Estática analógica de sintonización de radio (FM/AM hiss & hum)
        // =====================================================================
        const duration = 0.28;
        const bufferSize = Math.floor(ctx.sampleRate * duration);
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = (Math.random() * 2 - 1) * (0.8 + 0.2 * Math.sin(i * 0.01));
        }

        const noise = ctx.createBufferSource();
        noise.buffer = buffer;

        // Filtro pasabanda dinámico que barre frecuencias
        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.Q.value = 2.5;
        filter.frequency.setValueAtTime(900, now);
        filter.frequency.exponentialRampToValueAtTime(2800, now + duration * 0.7);

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.35, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

        // Zumbido eléctrico de fondo (mains hum 120Hz)
        const hum = ctx.createOscillator();
        const humGain = ctx.createGain();
        hum.type = 'sawtooth';
        hum.frequency.setValueAtTime(120, now);
        humGain.gain.setValueAtTime(0.08, now);
        humGain.gain.linearRampToValueAtTime(0.001, now + duration);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);

        hum.connect(humGain);
        humGain.connect(ctx.destination);

        noise.start(now);
        hum.start(now);
        hum.stop(now + duration);

      } else if (propKey === 'notebook') {
        // =====================================================================
        // 3. CUADERNO: Sonido de lápiz/bolígrafo escribiendo (trazos "scritch-scratch")
        // =====================================================================
        const strokes = [
          { start: now, dur: 0.05 },
          { start: now + 0.065, dur: 0.045 },
          { start: now + 0.125, dur: 0.06 },
        ];

        strokes.forEach((st) => {
          const sLen = Math.floor(ctx.sampleRate * st.dur);
          const sBuf = ctx.createBuffer(1, sLen, ctx.sampleRate);
          const sData = sBuf.getChannelData(0);
          for (let i = 0; i < sLen; i++) {
            // Textura rugosa de grafito sobre papel
            sData[i] = (Math.random() * 2 - 1) * Math.sin((i / sLen) * Math.PI);
          }

          const sSource = ctx.createBufferSource();
          sSource.buffer = sBuf;

          // Filtro que emula el timbre del papel y la mina del lápiz
          const sFilter = ctx.createBiquadFilter();
          sFilter.type = 'bandpass';
          sFilter.frequency.setValueAtTime(3600 + Math.random() * 400, st.start);
          sFilter.Q.value = 3.5;

          const sGain = ctx.createGain();
          sGain.gain.setValueAtTime(0.4, st.start);
          sGain.gain.exponentialRampToValueAtTime(0.01, st.start + st.dur);

          sSource.connect(sFilter);
          sFilter.connect(sGain);
          sGain.connect(ctx.destination);

          sSource.start(st.start);
        });

      } else if (propKey === 'shovel') {
        // =====================================================================
        // 4. PALA: Sonido de cavar tierra y gravilla ("crunch-scrape" terroso)
        // =====================================================================
        const duration = 0.32;
        const bufferSize = Math.floor(ctx.sampleRate * duration);
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);

        // Generar fricción granulada de arena, piedras y tierra húmeda
        for (let i = 0; i < bufferSize; i++) {
          const env = Math.exp(-i / (bufferSize * 0.45));
          const crunch = Math.random() > 0.88 ? (Math.random() * 2 - 1) * 2.0 : (Math.random() * 2 - 1) * 0.5;
          data[i] = crunch * env;
        }

        const source = ctx.createBufferSource();
        source.buffer = buffer;

        // Filtro terroso (lowpass) + resonancia del metal cortando grava
        const filter = ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(800, now);
        filter.frequency.linearRampToValueAtTime(450, now + duration);

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.5, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

        source.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);

        source.start(now);

      } else if (propKey === 'builders') {
        // =====================================================================
        // 5. PROYECTOS: Chisporroteo continuo de soldadura de arco (Arc Welding)
        // =====================================================================
        const duration = 0.28;
        const bufferSize = Math.floor(ctx.sampleRate * duration);
        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
        const data = buffer.getChannelData(0);

        // Arco eléctrico irregular con chispas crepitantes
        for (let i = 0; i < bufferSize; i++) {
          const spark = Math.random() > 0.82 ? (Math.random() * 2 - 1) * 1.8 : (Math.random() * 2 - 1) * 0.3;
          data[i] = spark;
        }

        const noise = ctx.createBufferSource();
        noise.buffer = buffer;

        const filter = ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(2200, now);
        filter.Q.value = 1.8;

        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.4, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

        // Zumbido eléctrico de 120Hz de la máquina de soldar
        const buzz = ctx.createOscillator();
        const buzzGain = ctx.createGain();
        buzz.type = 'sawtooth';
        buzz.frequency.setValueAtTime(120, now);
        buzzGain.gain.setValueAtTime(0.18, now);
        buzzGain.gain.linearRampToValueAtTime(0.001, now + duration);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);

        buzz.connect(buzzGain);
        buzzGain.connect(ctx.destination);

        noise.start(now);
        buzz.start(now);
        buzz.stop(now + duration);

      } else if (propKey === 'phone') {
        // =====================================================================
        // 6. TELÉFONO: Sonido de la rueda giratoria de disco volviendo (Trinquete)
        // =====================================================================
        const tickCount = 9;
        const interval = 0.024; // Frecuencia de los dientes de la rueda

        for (let i = 0; i < tickCount; i++) {
          const t = now + i * interval;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();

          osc.type = 'triangle';
          // Tono de cada clic metálico del engranaje de retorno
          osc.frequency.setValueAtTime(1400 + (i % 2) * 200, t);
          osc.frequency.exponentialRampToValueAtTime(300, t + 0.012);

          gain.gain.setValueAtTime(0.35, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.015);

          osc.connect(gain);
          gain.connect(ctx.destination);

          osc.start(t);
          osc.stop(t + 0.015);
        }

        // Golpe final de tope mecánico cuando la rueda llega a su lugar
        const stopTime = now + tickCount * interval;
        const stopOsc = ctx.createOscillator();
        const stopGain = ctx.createGain();
        stopOsc.type = 'sawtooth';
        stopOsc.frequency.setValueAtTime(450, stopTime);
        stopOsc.frequency.exponentialRampToValueAtTime(80, stopTime + 0.04);
        stopGain.gain.setValueAtTime(0.4, stopTime);
        stopGain.gain.exponentialRampToValueAtTime(0.001, stopTime + 0.04);

        stopOsc.connect(stopGain);
        stopGain.connect(ctx.destination);

        stopOsc.start(stopTime);
        stopOsc.stop(stopTime + 0.04);
      }
    } catch (e) {
      // Audio fallback silencioso
    }
  }

  // Prop Groups
  const props: Record<string, THREE.Group> = {};
  let currentActivePropKey = 'laptop';

  // Interpolation targets for smooth movement between pages
  const currentPos = new THREE.Vector3(0, 0, 0);
  const targetPos = new THREE.Vector3(0, 0, 0);
  let currentScale = 1.0;
  let targetScale = 1.0;

  // Mouse tilt tracking & auto-return to front (STRICTLY constrained to 3D container slot)
  let mouseNorm = { x: 0, y: 0 };
  let isDragging = false;
  let isHoveringSlot = false;
  let prevMouse = { x: 0, y: 0 };
  let manualRot = { x: 0, y: 0 };
  let glitchTimer = 0;

  // Scene Lights
  let ambientLight: THREE.AmbientLight | null = null;
  let keyLight: THREE.DirectionalLight | null = null;
  let amberRimLight: THREE.DirectionalLight | null = null;
  let phosphorFillLight: THREE.DirectionalLight | null = null;
  let sparkLight: THREE.PointLight | null = null;

  function updateThemeLighting() {
    // Pure Dark Mode: Atmospheric Analog Horror / Rustpunk lighting with warm amber rim glow
    // Gives soft, moody, high-relief illumination so dark metals stand out beautifully!
    if (ambientLight) {
      ambientLight.color.setHex(0x78350f); // Warm bronze-amber ambient lift
      ambientLight.intensity = 2.6;
    }
    if (keyLight) {
      keyLight.color.setHex(0xfef3c7); // Warm tungsten inspection light
      keyLight.intensity = 3.2;
    }
    if (amberRimLight) {
      amberRimLight.color.setHex(0xf59e0b); // Rich amber edge silhouette outline
      amberRimLight.intensity = 4.2;
    }
    if (phosphorFillLight) {
      phosphorFillLight.color.setHex(0x38bdf8); // Cyan CRT phosphor bounce fill
      phosphorFillLight.intensity = 1.8;
    }
  }

  function initGlobalRustScene() {
    const canvas = document.getElementById('rust-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    if (renderer) {
      updateTargetPositionFromDOM(false);
      attachSlotListeners();
      updateThemeLighting();
      return;
    }

    const width = window.innerWidth || 1200;
    const height = window.innerHeight || 800;

    scene = new THREE.Scene();
    camera = new THREE.PerspectiveCamera(36, width / height, 0.1, 100);
    camera.position.set(0, 0, 8.5);

    renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: false, // PSX Lo-Fi 3D look
      powerPreference: 'default',
    });
    renderer.setClearColor(0x000000, 0);
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

    // Directional & Ambient Lighting (No distance decay, consistent illumination in both left and right slots)
    ambientLight = new THREE.AmbientLight(0x78350f, 2.6);
    scene.add(ambientLight);

    keyLight = new THREE.DirectionalLight(0xfef3c7, 3.2);
    keyLight.position.set(3, 5, 4);
    scene.add(keyLight);

    amberRimLight = new THREE.DirectionalLight(0xf59e0b, 4.2);
    amberRimLight.position.set(0, 3, -5);
    scene.add(amberRimLight);

    phosphorFillLight = new THREE.DirectionalLight(0x38bdf8, 1.8);
    phosphorFillLight.position.set(-3.5, -1.5, 3);
    scene.add(phosphorFillLight);

    sparkLight = new THREE.PointLight(0x38bdf8, 0, 6);
    scene.add(sparkLight);

    updateThemeLighting();

    // Shared Base Materials (Tuned for gorgeous specular and diffuse response in both dark and light themes)
    const darkMetalMat = new THREE.MeshLambertMaterial({
      color: 0x3f3f48,
      flatShading: true,
    });
    const rustMetalMat = createRustedMetalMaterial();
    const woodMat = createWeatheredWoodMaterial();
    const copperMat = new THREE.MeshLambertMaterial({
      color: 0xd97706,
      flatShading: true,
    });
    const chromeMat = new THREE.MeshLambertMaterial({
      color: 0xe2e8f0,
      flatShading: true,
    });

    // =========================================================================
    // 1. PROP: Retro Laptop with Linux Console (PERFECTLY CENTERED AT 0,0,0)
    // =========================================================================
    const laptopGroup = new THREE.Group();
    const laptopInner = new THREE.Group(); // Inner container to balance center of mass
    laptopGroup.add(laptopInner);
    
    // Base Case (lowered so center of entire open laptop is exactly at Y=0)
    const baseGeo = new THREE.BoxGeometry(2.3, 0.2, 1.7);
    const laptopBase = new THREE.Mesh(baseGeo, darkMetalMat);
    laptopBase.position.set(0, -0.45, 0.2);
    laptopInner.add(laptopBase);

    // Keyboard Plate
    const kbPlateGeo = new THREE.PlaneGeometry(2.0, 0.9);
    const kbMat = createKeyboardMaterial();
    const kbPlate = new THREE.Mesh(kbPlateGeo, kbMat);
    kbPlate.rotation.x = -Math.PI / 2;
    kbPlate.position.set(0, -0.34, 0.35);
    laptopInner.add(kbPlate);

    // Red TrackPoint nub
    const nubGeo = new THREE.CylinderGeometry(0.04, 0.04, 0.06, 6);
    const nubMat = new THREE.MeshBasicMaterial({ color: 0xef4444 });
    const nub = new THREE.Mesh(nubGeo, nubMat);
    nub.position.set(0, -0.31, 0.35);
    laptopInner.add(nub);

    // Lid & Linux Console Screen
    const lidGroup = new THREE.Group();
    lidGroup.position.set(0, -0.35, -0.6);
    lidGroup.rotation.x = -0.32; // Open screen angle

    const lidBezelGeo = new THREE.BoxGeometry(2.3, 1.6, 0.1);
    const lidBezel = new THREE.Mesh(lidBezelGeo, darkMetalMat);
    lidBezel.position.set(0, 0.75, 0);
    lidGroup.add(lidBezel);

    const screenGeo = new THREE.PlaneGeometry(1.9, 1.3);
    const screenMat = createLinuxTerminalMaterial();
    const screenMesh = new THREE.Mesh(screenGeo, screenMat);
    screenMesh.position.set(0, 0.75, 0.06);
    lidGroup.add(screenMesh);

    laptopInner.add(lidGroup);
    props['laptop'] = laptopGroup;
    scene.add(laptopGroup);

    // =========================================================================
    // 2. PROP: Vintage Sony-Style Transistor Radio (Compact, Centered, No Overhang)
    // =========================================================================
    const radioGroup = new THREE.Group();
    const radioInner = new THREE.Group();
    radioGroup.add(radioInner);
    
    const rBodyGeo = new THREE.BoxGeometry(2.1, 1.35, 0.65);
    const rBody = new THREE.Mesh(rBodyGeo, darkMetalMat);
    radioInner.add(rBody);

    const grilleGeo = new THREE.PlaneGeometry(0.85, 1.05);
    const grilleMat = createRadioGrilleMaterial();
    const grille = new THREE.Mesh(grilleGeo, grilleMat);
    grille.position.set(-0.48, 0, 0.33);
    radioInner.add(grille);

    const tuneGeo = new THREE.PlaneGeometry(0.8, 0.42);
    const tuneMat = createRadioTuningDialMaterial();
    const tune = new THREE.Mesh(tuneGeo, tuneMat);
    tune.position.set(0.48, 0.28, 0.33);
    radioInner.add(tune);

    const knobGeo = new THREE.CylinderGeometry(0.26, 0.26, 0.16, 12);
    const knob = new THREE.Mesh(knobGeo, copperMat);
    knob.rotation.z = Math.PI / 2;
    knob.position.set(1.12, 0.28, 0);
    radioInner.add(knob);

    const volGeo = new THREE.CylinderGeometry(0.14, 0.14, 0.12, 10);
    const vol = new THREE.Mesh(volGeo, copperMat);
    vol.rotation.x = Math.PI / 2;
    vol.position.set(0.48, -0.3, 0.33);
    radioInner.add(vol);

    // Telescopic Antenna: Compact and collapsed flush along the top casing groove (no overhang)
    const antBaseGeo = new THREE.CylinderGeometry(0.04, 0.05, 0.08, 6);
    const antBase = new THREE.Mesh(antBaseGeo, copperMat);
    antBase.position.set(-0.75, 0.71, -0.15);
    radioInner.add(antBase);

    const antGeo = new THREE.CylinderGeometry(0.02, 0.025, 0.95, 6);
    const ant = new THREE.Mesh(antGeo, chromeMat);
    ant.rotation.z = Math.PI / 2; // Tucked flat and flush along top edge
    ant.position.set(-0.25, 0.72, -0.15);
    radioInner.add(ant);

    // Balanced centering around (0, 0, 0)
    radioInner.position.set(0, 0, 0);

    props['radio'] = radioGroup;
    radioGroup.visible = false;
    scene.add(radioGroup);

    // =========================================================================
    // 3. PROP: Open Code Notebook / Cuaderno de Código (Used on /formacion)
    // =========================================================================
    const notebookGroup = new THREE.Group();
    
    const coverGeo = new THREE.BoxGeometry(2.4, 1.7, 0.06);
    const coverMat = new THREE.MeshLambertMaterial({ color: 0x3b1d11, flatShading: true });
    const cover = new THREE.Mesh(coverGeo, coverMat);
    cover.position.set(0, 0, -0.04);
    notebookGroup.add(cover);

    const pageLGeo = new THREE.BoxGeometry(1.08, 1.55, 0.03);
    const pageLMat = createCodeNotebookPageLMaterial();
    const pageL = new THREE.Mesh(pageLGeo, pageLMat);
    pageL.position.set(-0.55, 0, 0);
    pageL.rotation.y = 0.08;
    notebookGroup.add(pageL);

    const pageRGeo = new THREE.BoxGeometry(1.08, 1.55, 0.03);
    const pageRMat = createCodeNotebookPageRMaterial();
    const pageR = new THREE.Mesh(pageRGeo, pageRMat);
    pageR.position.set(0.55, 0, 0);
    pageR.rotation.y = -0.08;
    notebookGroup.add(pageR);

    // Center Spiral Rings
    for (let i = -6; i <= 6; i++) {
      const ringGeo = new THREE.TorusGeometry(0.07, 0.016, 4, 8);
      const ring = new THREE.Mesh(ringGeo, copperMat);
      ring.position.set(0, i * 0.11, 0.04);
      notebookGroup.add(ring);
    }

    // Yellow Pencil
    const pencilGeo = new THREE.CylinderGeometry(0.035, 0.035, 1.4, 6);
    const pencilMat = new THREE.MeshLambertMaterial({ color: 0xeab308, flatShading: true });
    const pencil = new THREE.Mesh(pencilGeo, pencilMat);
    pencil.rotation.z = 0.65;
    pencil.position.set(0.18, -0.15, 0.09);
    notebookGroup.add(pencil);

    props['notebook'] = notebookGroup;
    notebookGroup.visible = false;
    scene.add(notebookGroup);

    // =========================================================================
    // 4. PROP: Auténtica Pala de Construcción Desgastada (Compact, Sleek, Centered)
    // =========================================================================
    const shovelGroup = new THREE.Group();
    const shovelInner = new THREE.Group();
    shovelGroup.add(shovelInner);

    // Spade Blade: authentic tapered, pointed steel blade (compact & proportional)
    const bladeShape = new THREE.Shape();
    bladeShape.moveTo(-0.28, 0.22);
    bladeShape.lineTo(0.28, 0.22);
    bladeShape.lineTo(0.26, -0.14);
    bladeShape.lineTo(0.0, -0.46);
    bladeShape.lineTo(-0.26, -0.14);
    bladeShape.closePath();

    const bladeGeo = new THREE.ExtrudeGeometry(bladeShape, {
      depth: 0.03,
      bevelEnabled: true,
      bevelSegments: 2,
      bevelSize: 0.012,
      bevelThickness: 0.012,
    });
    const bladeMesh = new THREE.Mesh(bladeGeo, rustMetalMat);
    bladeMesh.rotation.x = 0.12;
    bladeMesh.position.set(0, -0.42, 0.03);
    shovelInner.add(bladeMesh);

    // Step Ledge (reborde superior metálico donde se pisa)
    const stepLedgeGeo = new THREE.BoxGeometry(0.60, 0.05, 0.06);
    const stepLedge = new THREE.Mesh(stepLedgeGeo, rustMetalMat);
    stepLedge.position.set(0, -0.18, 0.02);
    shovelInner.add(stepLedge);

    // Socket (casquillo cónico de unión)
    const socketGeo = new THREE.CylinderGeometry(0.045, 0.06, 0.20, 8);
    const socketMesh = new THREE.Mesh(socketGeo, rustMetalMat);
    socketMesh.position.set(0, -0.07, 0.04);
    shovelInner.add(socketMesh);

    // Mango de madera torneada desgastada (proporción compacta)
    const shaftGeo = new THREE.CylinderGeometry(0.038, 0.038, 0.78, 8);
    const shaft = new THREE.Mesh(shaftGeo, woodMat);
    shaft.position.set(0, 0.40, 0.04);
    shovelInner.add(shaft);

    // Empuñadura en "D" clásica
    const dGripBaseGeo = new THREE.CylinderGeometry(0.045, 0.045, 0.10, 6);
    const dGripBase = new THREE.Mesh(dGripBaseGeo, rustMetalMat);
    dGripBase.position.set(0, 0.82, 0.04);
    shovelInner.add(dGripBase);

    const dArmGeo = new THREE.BoxGeometry(0.032, 0.20, 0.032);
    const dArmL = new THREE.Mesh(dArmGeo, rustMetalMat);
    dArmL.position.set(-0.12, 0.94, 0.04);
    shovelInner.add(dArmL);

    const dArmR = new THREE.Mesh(dArmGeo, rustMetalMat);
    dArmR.position.set(0.12, 0.94, 0.04);
    shovelInner.add(dArmR);

    const dHandleGeo = new THREE.CylinderGeometry(0.032, 0.032, 0.26, 8);
    const dHandle = new THREE.Mesh(dHandleGeo, woodMat);
    dHandle.rotation.z = Math.PI / 2;
    dHandle.position.set(0, 1.04, 0.04);
    shovelInner.add(dHandle);

    // Center of mass balanced at (0, 0, 0)
    shovelInner.position.set(0, -0.22, 0);
    // Showcase slight diagonal tilt
    shovelInner.rotation.z = 0.18;

    props['shovel'] = shovelGroup;
    shovelGroup.visible = false;
