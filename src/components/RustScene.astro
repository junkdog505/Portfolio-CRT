  // =========================================================================
  // Reposition & Switch Prop based on Active Page (Without jumping)
  // =========================================================================
  let hadRealAnchorBefore = false;

  function updateTargetPositionFromDOM(immediate = false) {
    const anchor = document.querySelector('[data-rust-slot]') as HTMLElement | null;
    const pathname = window.location.pathname;

    let targetPropKey = 'laptop';
    if (pathname.includes('/sobre-mi')) targetPropKey = 'radio';
    else if (pathname.includes('/formacion')) targetPropKey = 'notebook';
    else if (pathname.includes('/experiencia')) targetPropKey = 'shovel';
    else if (pathname.includes('/proyectos')) targetPropKey = 'builders';
    else if (pathname.includes('/contacto')) targetPropKey = 'phone';

    // Switch visible prop
    if (targetPropKey !== currentActivePropKey) {
      if (props[currentActivePropKey]) props[currentActivePropKey].visible = false;
      if (props[targetPropKey]) props[targetPropKey].visible = true;
      currentActivePropKey = targetPropKey;
    } else {
      // Ensure the active prop is visible and all others hidden
      Object.keys(props).forEach((key) => {
        if (props[key]) props[key].visible = (key === targetPropKey);
      });
    }

    if (camera) {
      const dist = camera.position.z;
      const vFOV = (camera.fov * Math.PI) / 180;
      const visibleHeight = 2 * Math.tan(vFOV / 2) * dist;
      const visibleWidth = visibleHeight * camera.aspect;

      // Default fallback dimensions if anchor is not yet rendered
      let centerX = window.innerWidth * 0.72;
      let centerY = window.innerHeight * 0.48;
      let widthPx = 380;
      let heightPx = 320;
      let hasRealAnchor = false;

      if (anchor) {
        const rect = anchor.getBoundingClientRect();
        if (rect.width > 20 && rect.height > 20) {
          centerX = rect.left + rect.width / 2;
          centerY = rect.top + rect.height / 2;
          widthPx = rect.width;
          heightPx = rect.height;
          hasRealAnchor = true;
        }
      }

      // Screen to 3D world projection at z = 0
      const ndcX = (centerX / window.innerWidth) * 2 - 1;
      const ndcY = -(centerY / window.innerHeight) * 2 + 1;

      targetPos.x = ndcX * (visibleWidth / 2);
      targetPos.y = ndcY * (visibleHeight / 2);
      targetPos.z = 0;

      // Slot dimensions in 3D world space
      const slotWorldW = (widthPx / window.innerHeight) * visibleHeight;
      const slotWorldH = (heightPx / window.innerHeight) * visibleHeight;
      const slotBoxSize = Math.min(slotWorldW, slotWorldH);

      // Base normalized size relative to model reference dimensions
      const normSize = slotBoxSize / 2.8;

      // Scale carefully tuned per prop so every object fits strictly within the container box
      const propScaleMultipliers: Record<string, number> = {
        laptop: 0.95,
        radio: 0.88,
        notebook: 0.86,
        shovel: 0.80, // Sleek, compact and strictly inside margins
        builders: 0.82,
        phone: 0.86,
      };
      const mult = propScaleMultipliers[targetPropKey] || 0.85;
      targetScale = Math.max(0.35, Math.min(0.95, normSize * mult));

      // Snap immediately if requested or if transitioning from fallback to first real anchor
      const shouldSnap = immediate || (!hadRealAnchorBefore && hasRealAnchor);

      if (shouldSnap) {
        currentPos.copy(targetPos);
        currentScale = targetScale;
        manualRot.x = 0;
        manualRot.y = 0;
        const activeGroup = props[currentActivePropKey];
        if (activeGroup) {
          activeGroup.position.copy(currentPos);
          activeGroup.scale.setScalar(currentScale);
          activeGroup.rotation.set(0, 0, 0);
        }
      }

      if (hasRealAnchor) {
        hadRealAnchorBefore = true;
      }
    }
  }

  // =========================================================================
  // Animation Loop with Auto-Return to Front
  // =========================================================================
  let lastTime = performance.now();

  function animateRustScene(time: number) {
    animationFrameId = requestAnimationFrame(animateRustScene);
    const rawDelta = (time - lastTime) * 0.001;
    lastTime = time;
    // Clamp delta to prevent huge jumps if tab was backgrounded
    const delta = Math.min(rawDelta, 0.05);

    // Delta-timed exponential smoothing: buttery-smooth 60 / 120 / 144 FPS motion
    const moveFactor = 1 - Math.exp(-8.5 * delta);
    currentPos.lerp(targetPos, moveFactor);
    currentScale += (targetScale - currentScale) * moveFactor;

    if (currentPos.distanceTo(targetPos) < 0.002) {
      currentPos.copy(targetPos);
    }

    // Auto-return to front: smoothly decay manual rotation to 0
    if (!isDragging) {
      const decayFactor = Math.exp(-6.0 * delta);
      manualRot.x *= decayFactor;
      manualRot.y *= decayFactor;
      if (Math.abs(manualRot.x) < 0.0005) manualRot.x = 0;
      if (Math.abs(manualRot.y) < 0.0005) manualRot.y = 0;
    }

    const activeGroup = props[currentActivePropKey];
    if (activeGroup) {
      activeGroup.position.copy(currentPos);
      activeGroup.scale.setScalar(currentScale);

      // Mouse influence: subtle front tilt ONLY when pointer is hovering inside the container slot!
      const subtleTiltX = (isHoveringSlot && !isDragging) ? mouseNorm.y * 0.12 : 0;
      const subtleTiltY = (isHoveringSlot && !isDragging) ? mouseNorm.x * 0.18 : 0;

      let baseRotX = 0;
      let baseRotY = 0;
      let baseRotZ = 0;

      if (currentActivePropKey === 'laptop') {
        baseRotX = 0.28;
      } else if (currentActivePropKey === 'notebook') {
        baseRotX = 0.45;
      } else if (currentActivePropKey === 'shovel') {
        baseRotZ = 0.15;
      } else if (currentActivePropKey === 'phone') {
        baseRotX = 0.25;
      }

      const targetX = baseRotX + manualRot.x + subtleTiltX;
      const targetY = baseRotY + manualRot.y + subtleTiltY;
      const targetZ = baseRotZ;

      const rotFactor = 1 - Math.exp(-9.0 * delta);
      activeGroup.rotation.x += (targetX - activeGroup.rotation.x) * rotFactor;
      activeGroup.rotation.y += (targetY - activeGroup.rotation.y) * rotFactor;
      activeGroup.rotation.z += (targetZ - activeGroup.rotation.z) * rotFactor;

      // Subtle atmospheric hover
      activeGroup.position.y += Math.sin(time * 0.002) * 0.015;

      // Spark light flickering for builders prop
      if (sparkLight) {
        if (currentActivePropKey === 'builders') {
          sparkLight.position.set(currentPos.x - 0.3, currentPos.y, currentPos.z + 0.4);
          sparkLight.intensity = Math.random() > 0.7 ? Math.random() * 3.0 : 0;
        } else {
          sparkLight.intensity = 0;
        }
      }
    }

    // Camera glitch vibration
    if (glitchTimer > 0) {
      glitchTimer--;
      camera.position.x = (Math.random() - 0.5) * 0.05;
      camera.position.y = (Math.random() - 0.5) * 0.05;
    } else {
      camera.position.x = 0;
      camera.position.y = 0;
    }

    if (renderer && scene && camera) {
      renderer.render(scene, camera);
    }
  }

  // =========================================================================
  // Slot-Constrained Interactions: Drag & Sound ONLY inside the prop's slot
  // =========================================================================
  function attachSlotListeners() {
    const slot = document.querySelector('[data-rust-slot]') as HTMLElement | null;
    if (!slot) return;

    slot.style.touchAction = 'none';

    slot.onpointerenter = () => {
      isHoveringSlot = true;
    };

    slot.onpointerleave = () => {
      isHoveringSlot = false;
      if (!isDragging) {
        mouseNorm.x = 0;
        mouseNorm.y = 0;
      }
    };

    let pointerDownPos = { x: 0, y: 0 };

    slot.onpointerdown = (e: PointerEvent) => {
      if (e.button !== 0) return;
      isDragging = true;
      isHoveringSlot = true;
      prevMouse = { x: e.clientX, y: e.clientY };
      pointerDownPos = { x: e.clientX, y: e.clientY };

      // Procedural audio triggers STRICTLY when clicking inside the slot container!
      playPropSound(currentActivePropKey);
      triggerRustGlitch();

      try {
        slot.setPointerCapture(e.pointerId);
      } catch (_) {}
    };

    slot.onpointermove = (e: PointerEvent) => {
      const rect = slot.getBoundingClientRect();
      const relX = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      const relY = -(((e.clientY - rect.top) / rect.height) * 2 - 1);
      mouseNorm.x = Math.max(-1, Math.min(1, relX));
      mouseNorm.y = Math.max(-1, Math.min(1, relY));

      if (isDragging) {
        const deltaX = e.clientX - prevMouse.x;
        const deltaY = e.clientY - prevMouse.y;
        manualRot.y += deltaX * 0.012;
        manualRot.x += deltaY * 0.009;
        prevMouse = { x: e.clientX, y: e.clientY };
      }
    };

    slot.onpointerup = (e: PointerEvent) => {
      isDragging = false;
      const dist = Math.hypot(e.clientX - pointerDownPos.x, e.clientY - pointerDownPos.y);
      if (dist < 28 && currentActivePropKey === 'laptop') {
        window.dispatchEvent(new CustomEvent('laptop-easter-egg'));
      }
      try {
        slot.releasePointerCapture(e.pointerId);
      } catch (_) {}
    };

    slot.onpointercancel = () => {
      isDragging = false;
      isHoveringSlot = false;
    };
  }

  // Safety fallback for pointer release outside window
  window.addEventListener('pointerup', () => {
    isDragging = false;
  });

  function handleResize() {
    if (!renderer || !camera) return;
    const width = window.innerWidth;
    const height = window.innerHeight;
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
    renderer.setSize(width, height);
    updateTargetPositionFromDOM(false);
  }

  window.addEventListener('resize', handleResize);
  window.addEventListener('scroll', () => updateTargetPositionFromDOM(false), { passive: true });

  // Continuous slot monitoring so the 3D model always tracks DOM shifts, fonts, and visibility
  let slotResizeObserver: ResizeObserver | null = null;
  function setupSlotObserver() {
    if (slotResizeObserver) {
      slotResizeObserver.disconnect();
      slotResizeObserver = null;
    }
    const slot = document.querySelector('[data-rust-slot]') as HTMLElement | null;
    if (slot && typeof ResizeObserver !== 'undefined') {
      slotResizeObserver = new ResizeObserver((entries) => {
        for (const entry of entries) {
          if (entry.contentRect.width > 20 && entry.contentRect.height > 20) {
            updateTargetPositionFromDOM(false);
          }
        }
      });
      slotResizeObserver.observe(slot);
    }
  }

  // Synchronization with initial splash screen reveal: snap model right to slot behind dissolving curtain
  window.addEventListener('portfolio-booted', () => {
    requestAnimationFrame(() => {
      updateTargetPositionFromDOM(true);
      attachSlotListeners();
      setupSlotObserver();
      updateThemeLighting();
    });
    // Extra guard passes during dissolve animation
    setTimeout(() => updateTargetPositionFromDOM(false), 200);
    setTimeout(() => updateTargetPositionFromDOM(false), 500);
  });

  // Immediate initialization: start Three.js without waiting solely for deferred events
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initGlobalRustScene();
        setupSlotObserver();
      });
    } else {
      initGlobalRustScene();
      setupSlotObserver();
    }
    window.addEventListener('load', () => {
      initGlobalRustScene();
      updateTargetPositionFromDOM(false);
      attachSlotListeners();
      setupSlotObserver();
    });
  }

  // Astro View Transitions Hooks
  document.addEventListener('astro:page-load', () => {
    initGlobalRustScene();
    requestAnimationFrame(() => {
      updateTargetPositionFromDOM(false);
      attachSlotListeners();
      setupSlotObserver();
      updateThemeLighting();
    });
  });

  document.addEventListener('astro:after-swap', () => {
    hadRealAnchorBefore = false;
    requestAnimationFrame(() => {
      updateTargetPositionFromDOM(false);
      attachSlotListeners();
      setupSlotObserver();
      updateThemeLighting();
    });
  });

</script>
