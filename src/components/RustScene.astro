    cupR.position.set(0.65, 0, 0);
    cupR.rotation.z = -Math.PI / 2;
    handsetGroup.add(cupR);

    phoneInner.add(handsetGroup);

    props['phone'] = phoneGroup;
    phoneGroup.visible = false;
    scene.add(phoneGroup);

    // Attach interaction listeners exclusively to the designated page slot container
    attachSlotListeners();

    // Snap prop immediately to destination position on initial load
    updateTargetPositionFromDOM(true);

    // Initial frame render
    try {
      renderer.render(scene, camera);
    } catch (_) {}

    // Start Animation Loop
    if (!animationFrameId) {
      animateRustScene(performance.now());
    }
  }

