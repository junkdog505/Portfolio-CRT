---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RustScene from '../components/RustScene.astro';
import CRTWarp from '../components/CRTWarp.astro';
import CRTSplash from '../components/CRTSplash.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = 'Portafolio Profesional | Full-Stack & Creative Developer',
  description = 'Portafolio web profesional con experiencias interactivas en 3D y desarrollo full-stack.',
  isHome = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-black text-zinc-300">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- CRT Boot & Theme Initializer: Runs synchronously in <head> before any DOM is rendered -->
    <script is:inline>
      const initBootAndTheme = () => {
        const isBooted = sessionStorage.getItem('portfolio_crt_booted') === 'true' || sessionStorage.getItem('portfolio_door_opened') === 'true';
        if (isBooted) {
          document.documentElement.classList.add('crt-booted');
          const theme = localStorage.getItem('portfolio-theme') || 'light';
          if (theme !== 'dark') {
            document.documentElement.classList.add('light-theme');
          } else {
            document.documentElement.classList.remove('light-theme');
          }
        } else {
          // Keep dark mode during initial splash screen (prevents white/light flash in production)
          document.documentElement.classList.remove('light-theme', 'crt-booted');
        }
      };
      initBootAndTheme();
      document.addEventListener('astro:after-swap', initBootAndTheme);
    </script>

    <!-- Critical Zero-Flash Preboot Inline Styles (Guarantees zero content flash before splash) -->
    <style is:inline id="critical-boot-curtain-style">
      /* Initial state before splash screen boots: entire page content is hidden */
      #app-content-root {
        display: none !important;
      }
      /* When booted, reveal application content */
      html.crt-booted #app-content-root {
        display: flex !important;
      }
      /* Hide splash screen and curtain immediately if booted */
      html.crt-booted #crt-splash-screen,
      html.crt-booted #critical-boot-curtain {
        display: none !important;
        pointer-events: none !important;
      }
      /* Fallback black shield at 0ms */
      #critical-boot-curtain {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        width: 100dvw !important;
        height: 100vh !important;
        height: 100dvh !important;
        background-color: #000000 !important;
        z-index: 2147483647 !important;
        pointer-events: none !important;
      }
    </style>

    <!-- Astro View Transitions -->
    <ClientRouter />
  </head>
  <body class={`bg-[#0a0a0c] text-zinc-300 antialiased flex flex-col relative font-mono selection:bg-amber-700 selection:text-amber-100 ${
    isHome ? 'h-screen h-[100dvh] max-h-[100dvh] overflow-hidden' : 'min-h-screen overflow-x-hidden'
  }`}>
    <!-- Instant 0ms Critical Black Curtain (Guarantees zero flash of page content on first visit) -->
    <div id="critical-boot-curtain" aria-hidden="true"></div>

    <!-- CRT TV Turn-On / Resident Evil 3D Door Splash Screen -->
    <CRTSplash />

    <!-- Application Content Root (Hidden until splash sequence finishes) -->
    <div id="app-content-root" class={`relative flex flex-col flex-1 w-full ${isHome ? 'h-full overflow-hidden' : 'min-h-screen overflow-x-hidden'}`}>

    <!-- Persistent Full-Width CRT Warp Plasma Background across all pages -->
    <div
      id="crt-warp-bg-layer"
      transition:persist="crt-warp-bg"
      style={`view-transition-name: none !important; opacity: ${isHome ? '0.45' : '0.18'};`}
      class="fixed inset-0 w-screen h-screen pointer-events-none z-0 overflow-hidden transition-opacity duration-500"
    >
      <CRTWarp
        color="#f59e0b"
        backgroundColor="#07060a"
        speed={0.4}
        curvature={0.2}
        scanlineStrength={0.2}
        scanlineFrequency={200}
        waveAmplitude={0.24}
        waveFrequency={2.4}
        bloom={1.4}
        bloomRadius={1}
        noise={0.04}
        vignette={0.12}
        brightness={1.2}
        pixelation={1}
        rgbShift={0.012}
        mouseReact={true}
        mouseStrength={0.45}
        dpr={1}
        fps={60}
        paused={false}
        autoTheme={true}
      />
    </div>

    <!-- CRT TV Screen & Scanlines Overlay -->
    <div class="crt-overlay"></div>

    <!-- Persistent Three.js 3D Scene across all pages -->
    <RustScene />

    <!-- Navigation Header -->
    <Navbar />
    
    <!-- Main Content with Slot -->
    <div class={`relative z-10 flex flex-col ${
      isHome 
        ? 'h-full flex-1 pt-18 sm:pt-20 pb-0 overflow-hidden' 
        : 'flex-1 pt-24 pb-12'
    }`}>
      <slot />
    </div>

    <!-- Telemetry Footer (only on scrollable content pages; Home has its own docked 100vh footer) -->
    {!isHome && <Footer />}
    </div>

    <script>
      // Ensure home page is strictly 100vh with zero scroll and adjust background opacity
      function enforcePageScrollPolicy() {
        const isHomePage = window.location.pathname === '/' || window.location.pathname === '';
        if (isHomePage) {
          document.body.classList.add('overflow-hidden', 'h-screen', 'max-h-screen');
          document.documentElement.classList.add('overflow-hidden');
        } else {
          document.body.classList.remove('overflow-hidden', 'h-screen', 'max-h-screen');
          document.documentElement.classList.remove('overflow-hidden');
        }

        // Adjust CRT Warp background opacity: atmospheric (0.45) on Home, subtle (0.18) on content pages
        const bgLayer = document.getElementById('crt-warp-bg-layer');
        if (bgLayer) {
          bgLayer.style.opacity = isHomePage ? '0.45' : '0.18';
        }
      }

      document.addEventListener('astro:page-load', enforcePageScrollPolicy);
    </script>
  </body>
</html>
