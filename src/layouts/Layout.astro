---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RustScene from '../components/RustScene.astro';
import CRTWarp from '../components/CRTWarp.astro';
import CRTSplash from '../components/CRTSplash.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = 'Portafolio Profesional | Full-Stack & Creative Developer',
  description = 'Portafolio web profesional con experiencias interactivas en 3D y desarrollo full-stack.',
  isHome = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-black text-zinc-300">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- CRT Boot State Manager: Runs synchronously in <head> before any DOM is rendered -->
    <script is:inline>
      (function() {
        try {
          const hasSeen = localStorage.getItem('portfolio_splash_seen') === 'true' ||
                          sessionStorage.getItem('portfolio_splash_seen') === 'true' ||
                          sessionStorage.getItem('portfolio_door_opened') === 'true' ||
                          sessionStorage.getItem('portfolio_crt_booted') === 'true';
          if (!hasSeen) {
            document.documentElement.classList.add('needs-splash');
          } else {
            document.documentElement.classList.remove('needs-splash');
            document.documentElement.classList.add('crt-booted');
          }
          document.documentElement.classList.remove('light-theme');
          localStorage.removeItem('portfolio-theme');
        } catch (e) {}
      })();
      document.addEventListener('astro:after-swap', () => {
        try {
          const hasSeen = localStorage.getItem('portfolio_splash_seen') === 'true' ||
                          sessionStorage.getItem('portfolio_splash_seen') === 'true' ||
                          sessionStorage.getItem('portfolio_door_opened') === 'true' ||
                          sessionStorage.getItem('portfolio_crt_booted') === 'true';
          if (!hasSeen) {
            document.documentElement.classList.add('needs-splash');
          } else {
            document.documentElement.classList.remove('needs-splash');
            document.documentElement.classList.add('crt-booted');
          }
        } catch (e) {}
      });
    </script>

    <!-- Critical Zero-Flash Preboot Inline Styles -->
    <style is:inline id="critical-boot-curtain-style">
      /* Pure dark CRT terminal background enforced at 0ms */
      :root, html {
        background-color: #0a0a0c !important;
        color-scheme: dark !important;
      }
      body {
        background-color: #0a0a0c !important;
      }

      /* DEFAULT STATE (Normal page, F5 reloads): Page is active, Splash is totally DEAD */
      #app-content-root {
        display: flex !important;
      }
      #crt-splash-screen,
      #critical-boot-curtain {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
        position: absolute !important;
        top: -99999px !important;
        left: -99999px !important;
        width: 0 !important;
        height: 0 !important;
      }

      /* FIRST VISIT ONLY: Active strictly when needs-splash is set */
      html.needs-splash #app-content-root {
        display: none !important;
      }
      html.needs-splash #crt-splash-screen {
        display: flex !important;
        visibility: visible !important;
        opacity: 1 !important;
        pointer-events: auto !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        width: 100dvw !important;
        height: 100vh !important;
        height: 100dvh !important;
        background-color: #000000 !important;
        z-index: 9999999 !important;
      }
      html.needs-splash #critical-boot-curtain {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        width: 100dvw !important;
        height: 100vh !important;
        height: 100dvh !important;
        background-color: #000000 !important;
        z-index: 2147483647 !important;
        pointer-events: none !important;
      }
    </style>

    <!-- Astro View Transitions -->
    <ClientRouter />
  </head>
  <body class="bg-[#0a0a0c] text-zinc-300 antialiased flex flex-col relative font-mono selection:bg-amber-700 selection:text-amber-100 min-h-screen overflow-x-hidden">
    <!-- Instant 0ms Critical Black Curtain (Guarantees zero flash of page content on first visit) -->
    <div id="critical-boot-curtain" style="display: none; opacity: 0; visibility: hidden;" aria-hidden="true"></div>

    <!-- CRT TV Turn-On / Resident Evil 3D Door Splash Screen -->
    <CRTSplash />

    <!-- Synchronous DOM pruner: permanently eliminates splash from DOM at parse time if not needed -->
    <script is:inline>
      (function() {
        try {
          const hasSeen = localStorage.getItem('portfolio_splash_seen') === 'true' ||
                          sessionStorage.getItem('portfolio_splash_seen') === 'true' ||
                          sessionStorage.getItem('portfolio_door_opened') === 'true' ||
                          sessionStorage.getItem('portfolio_crt_booted') === 'true';
          if (hasSeen || !document.documentElement.classList.contains('needs-splash')) {
            const splashEl = document.getElementById('crt-splash-screen');
            if (splashEl) splashEl.remove();
            const curtainEl = document.getElementById('critical-boot-curtain');
            if (curtainEl) curtainEl.remove();
          }
        } catch (e) {}
      })();
    </script>

    <!-- Application Content Root (Hidden until splash sequence finishes) -->
    <div id="app-content-root" class="relative flex flex-col flex-1 w-full min-h-screen overflow-x-hidden">

    <!-- Persistent Full-Width CRT Warp Plasma Background across all pages -->
    <div
      id="crt-warp-bg-layer"
      transition:persist="crt-warp-bg"
      style="view-transition-name: none !important; opacity: 0; transition: opacity 0.6s ease-out;"
      class="fixed inset-0 w-screen h-screen pointer-events-none z-0 overflow-hidden"
    >
      <CRTWarp
        color="#f59e0b"
        backgroundColor="#07060a"
        speed={0.4}
        curvature={0.2}
        scanlineStrength={0.2}
        scanlineFrequency={200}
        waveAmplitude={0.24}
        waveFrequency={2.4}
        bloom={1.4}
        bloomRadius={1}
        noise={0.04}
        vignette={0.12}
        brightness={1.2}
        pixelation={1}
        rgbShift={0.012}
        mouseReact={true}
        mouseStrength={0.45}
        dpr={1}
        fps={60}
        paused={false}
      />
    </div>

    <!-- CRT TV Screen & Scanlines Overlay -->
    <div class="crt-overlay"></div>

    <!-- Persistent Three.js 3D Scene across all pages -->
    <RustScene />

    <!-- Navigation Header -->
    <Navbar />
    
    <!-- Main Content with Slot -->
    <div class={`relative z-10 flex flex-col ${
      isHome 
        ? 'min-h-full flex-1 pt-16 sm:pt-20 pb-0' 
        : 'flex-1 pt-20 sm:pt-24 pb-12'
    }`}>
      <slot />
    </div>

    <!-- Telemetry Footer (only on scrollable content pages; Home has its own docked 100vh footer) -->
    {!isHome && <Footer />}
    </div>

    <script>
      let warpInitialized = false;

      // Manage CRT Warp background opacity and responsive scroll policy
      function enforcePageScrollPolicy() {
        const isHomePage = window.location.pathname === '/' || window.location.pathname === '';
        document.body.classList.remove('overflow-hidden', 'h-screen', 'max-h-screen');
        document.documentElement.classList.remove('overflow-hidden');

        // Adjust CRT Warp background opacity: atmospheric (0.45) on Home, subtle (0.18) on content pages
        const bgLayer = document.getElementById('crt-warp-bg-layer');
        if (bgLayer) {
          const targetOpacity = isHomePage ? '0.45' : '0.18';
          const isSplashActive = document.documentElement.classList.contains('needs-splash');

          if (isSplashActive) {
            // Splash screen is running; wait for 'portfolio-booted' event before revealing CRT warp
            return;
          }

          if (!warpInitialized) {
            // Initial load / F5 reload: start with solid dark background, wait 0.6s, then smoothly fade in
            setTimeout(() => {
              bgLayer.style.opacity = targetOpacity;
              warpInitialized = true;
            }, 600);
          } else {
            // Subsequent SPA route transitions: update opacity smoothly right away
            bgLayer.style.opacity = targetOpacity;
          }
        }
      }

      window.addEventListener('resize', enforcePageScrollPolicy);
      window.addEventListener('portfolio-booted', () => {
        const isHomePage = window.location.pathname === '/' || window.location.pathname === '';
        const bgLayer = document.getElementById('crt-warp-bg-layer');
        if (bgLayer) {
          const targetOpacity = isHomePage ? '0.45' : '0.18';
          setTimeout(() => {
            bgLayer.style.opacity = targetOpacity;
            warpInitialized = true;
          }, 350);
        }
      });

      document.addEventListener('astro:page-load', enforcePageScrollPolicy);
    </script>
  </body>
</html>
