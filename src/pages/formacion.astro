---
import Layout from '../layouts/Layout.astro';

const formacion = [
  {
    titulo: 'Grado Universitario en Ingeniería de Software & Computación',
    instituto: 'Facultad de Ingeniería y Ciencias Aplicadas',
    periodo: '2019 - 2024',
    mencion: 'Graduado con Honores / Especialidad en Sistemas Distribuidos y Gráficos',
    descripcion: 'Formación rigurosa en ciencias de la computación: estructuras de datos avanzadas, análisis asintótico de algoritmos, compiladores, arquitectura de computadoras, redes y computación gráfica tridimensional.',
    destacados: [
      'Proyecto de Tesis de Grado: Motor de renderizado WebGL para visualización de grafos multidimensionales.',
      'Promedio sobresaliente en materias de matemáticas aplicadas, álgebra lineal y física computacional.',
    ],
  },
  {
    titulo: 'Especialización en Computación Gráfica, WebGL & Shaders GLSL',
    instituto: 'Programa Avanzado de Gráficos Interactivos',
    periodo: '2023 - 2024',
    mencion: 'Certificación de Maestría en Shaders y WebGL',
    descripcion: 'Entrenamiento intensivo en el pipeline gráfico programable, cálculo de iluminación Phong y PBR (Physically Based Rendering), Raymarching matemático y técnicas de post-procesado con render passes personalizados.',
    destacados: [
      'Implementación de efectos analógicos CRT, aberración cromática y partículas en GPU.',
      'Optimización de matrices de transformación y buffers de geometría para 60 FPS en navegadores móviles.',
    ],
  },
];

const certificaciones = [
  {
    id: 'CERT-001',
    nombre: 'Three.js Journey - 3D Web Graphics',
    emisor: 'Bruno Simon (Experto Internacional Three.js)',
    ano: '2024',
    credencial: 'VERIFIED // THREEJS-9842',
    foco: 'WebGL, Blender Pipeline, Shaders, Raycasting, Physics Engine',
  },
  {
    id: 'CERT-002',
    nombre: 'Advanced TypeScript & Architecture Patterns',
    emisor: 'Certificación Profesional Internacional',
    ano: '2023',
    credencial: 'VERIFIED // TS-ARCH-5510',
    foco: 'Genéricos Avanzados, Conditional Types, Clean Architecture, DDD',
  },
  {
    id: 'CERT-003',
    nombre: 'Web Performance & Core Web Vitals Specialist',
    emisor: 'Google Web Standards & Chrome Performance',
    ano: '2023',
    credencial: 'VERIFIED // CWV-OPT-7741',
    foco: 'LCP < 800ms, CLS = 0, INP < 50ms, Memory Leak Profiling',
  },
];
---

<Layout title="Formación | Educación & Certificaciones de Ingeniería" description="Trayectoria académica formal, títulos universitarios, especializaciones en computación gráfica y certificaciones verificadas.">
  <main class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Top Grid: Content on the Left / 3D Notebook on the Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-12">
      <div class="lg:col-span-7 space-y-4">
        <!-- Reticle badge -->
        <div class="inline-flex items-center gap-2 border border-amber-800/80 bg-amber-950/30 px-3 py-1 text-xs text-amber-400 font-bold crt-text-amber">
          <span>&gt;_ REGISTRO: ACADEMIC_LOG [0x02]</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-zinc-100 uppercase tracking-tight">
          FORMACIÓN & ESTUDIOS
        </h1>

        <p class="text-sm sm:text-base text-zinc-300 leading-relaxed border-l-2 border-amber-700/80 pl-4 bg-[#121116]/70 py-2.5">
          Fundamentos sólidos de ciencias de la computación e ingeniería de software, complementados con aprendizaje continuo y certificaciones especializadas en tecnologías web avanzadas.
        </p>

        <!-- Academic metrics bar -->
        <div class="grid grid-cols-3 gap-2.5 pt-2 font-mono">
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-amber-500 crt-text-amber">5 AÑOS</span>
            <span class="text-[9px] text-zinc-400 uppercase">Carrera Grado</span>
          </div>
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-emerald-400 crt-text-green">100%</span>
            <span class="text-[9px] text-zinc-400 uppercase">Aprobación</span>
          </div>
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-amber-500 crt-text-amber">3 ESPECIALIDADES</span>
            <span class="text-[9px] text-zinc-400 uppercase">3D, Web & Tipado</span>
          </div>
        </div>
      </div>

      <!-- Right Column: 3D Slot for Open Code Notebook -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-full max-w-md aspect-square border border-[#451a03] bg-[#0c0c10]/85 p-4 relative shadow-2xl flex flex-col backdrop-blur-sm tech-card">
          <!-- Corner brackets -->
          <div class="tech-corner-tl"></div>
          <div class="tech-corner-tr"></div>
          <div class="tech-corner-bl"></div>
          <div class="tech-corner-br"></div>

          <div class="flex items-center justify-between text-[11px] text-amber-500 font-mono mb-2 border-b border-amber-900/40 pb-1.5">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              <span class="crt-text-amber font-bold">BITÁCORA DE CÓDIGO</span>
            </div>
            <span class="text-amber-400 animate-pulse font-bold text-[10px]">● ALGORITMOS</span>
          </div>

          <!-- 3D Anchor for Code Notebook (on the RIGHT side) -->
          <div
            id="scene-anchor"
            data-rust-slot="notebook"
            class="w-full flex-1 min-h-[300px] flex items-center justify-center cursor-grab select-none relative"
            title="Haz clic o arrastra para rotar la libreta de código (emite sonido de escritura en papel)"
          >
            <!-- 3D Open Code Notebook aligns here -->
          </div>

          <div class="flex items-center justify-between text-[10px] text-zinc-500 font-mono border-t border-amber-900/30 pt-1.5 mt-1">
            <span>REGISTRO DE APUNTES // C++ & GLSL</span>
            <span class="text-amber-500 crt-text-amber font-bold">SONIDO: PAPEL</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Academic Education Cards -->
    <div class="space-y-6 mb-12">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest crt-text-amber flex items-center gap-2">
          <span>[ // ESTUDIOS UNIVERSITARIOS & ESPECIALIZACIONES // ]</span>
        </h2>
        <span class="text-zinc-500 font-mono text-[10px]">[TÍTULOS OFICIALES]</span>
      </div>

      {formacion.map((item, idx) => (
        <div class="border border-amber-900/50 bg-[#111116] p-6 relative tech-card">
          <div class="tech-corner-tl"></div>
          <div class="tech-corner-tr"></div>
          <div class="tech-corner-bl"></div>
          <div class="tech-corner-br"></div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-amber-900/30 pb-3 mb-3">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-amber-500 font-mono text-xs font-bold">[{String(idx + 1).padStart(2, '0')}]</span>
                <h3 class="text-base font-bold text-zinc-100 uppercase tracking-tight">{item.titulo}</h3>
              </div>
              <p class="text-xs font-mono text-amber-400 crt-text-amber">{item.mencion}</p>
            </div>
            <span class="text-xs font-mono px-3 py-1 bg-amber-950/40 text-amber-400 border border-amber-800/60 w-fit self-start sm:self-auto font-bold">
              {item.periodo}
            </span>
          </div>

          <p class="text-xs font-mono text-zinc-400 mb-3">{item.instituto}</p>
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-4">{item.descripcion}</p>

          <div class="bg-[#0c0c10] border border-amber-900/30 p-3 space-y-1.5 font-mono text-xs">
            <span class="text-[10px] text-zinc-500 uppercase block font-bold">// ASPECTOS TÉCNICOS DESTACADOS</span>
            {item.destacados.map((point) => (
              <div class="flex items-start gap-2 text-zinc-300">
                <span class="text-emerald-400">&bull;</span>
                <span>{point}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Certifications Matrix -->
    <div class="mb-12">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest crt-text-amber">
          [ // CREDENCIALES & CERTIFICACIONES PROFESIONALES // ]
        </h2>
        <span class="text-emerald-400 font-mono text-[10px]">● ESTADO: 100% VALIDADAS</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
        {certificaciones.map((cert) => (
          <div class="border border-amber-900/40 bg-[#111116] p-5 text-xs flex flex-col justify-between relative tech-card">
            <div class="tech-corner-tl"></div>
            <div class="tech-corner-tr"></div>
            <div class="tech-corner-bl"></div>
            <div class="tech-corner-br"></div>

            <div>
              <div class="flex items-center justify-between text-[10px] font-mono text-zinc-500 mb-2 border-b border-amber-900/30 pb-1">
                <span class="text-amber-500 font-bold">{cert.id}</span>
                <span>[{cert.ano}]</span>
              </div>
              <h4 class="font-bold text-zinc-100 uppercase mb-1 leading-snug">{cert.nombre}</h4>
              <p class="text-zinc-400 text-[11px] font-mono mb-3">{cert.emisor}</p>
              <div class="bg-[#0c0c10] p-2 border border-zinc-800 text-[11px] text-zinc-300 font-mono">
                <span class="text-[9px] text-zinc-500 block uppercase">Competencias:</span>
                {cert.foco}
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-amber-900/30">
              <span class="crt-btn crt-btn-green text-[10px] py-1 px-2.5 w-full justify-center">
                [ {cert.credencial} ]
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Action Button -->
      <div class="flex justify-center">
        <a href="/contacto" class="crt-btn text-xs py-3 px-8">
          <span>[ SOLICITAR COPIA DE CREDENCIALES & TÍTULOS ]</span>
        </a>
      </div>
    </div>
  </main>
</Layout>
