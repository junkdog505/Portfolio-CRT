---
import Layout from '../layouts/Layout.astro';

const proyectos = [
  {
    codigo: 'PROJ_01',
    titulo: 'WebGL 3D Product Configurator & PBR Studio',
    subtitulo: 'Motor de personalización tridimensional en tiempo real',
    descripcion: 'Configurador 3D de alta fidelidad para productos industriales y de consumo. Implementa renderizado PBR con mapeo de entorno HDRI, shaders GLSL para materiales procedurales (metales cepillados, carbono, vidrio con refracción) y optimización geométrica con compresión Draco.',
    metricas: '60 FPS estables en móviles // <2.5MB peso inicial // WebGL 2.0',
    tags: ['Three.js', 'WebGL', 'GLSL Shaders', 'TypeScript', 'Astro 5'],
    demoUrl: '#',
    repoUrl: 'https://github.com',
    destacado: true,
  },
  {
    codigo: 'PROJ_02',
    titulo: 'Real-Time Telemetry & Systems Dashboard',
    subtitulo: 'Monitoreo de alta concurrencia con WebSockets & Canvas 2D',
    descripcion: 'Panel de control analítico diseñado para ingesta continua de métricas de servidores y telemetría de red. Emplea un motor de visualización en Canvas 2D para graficar más de 50,000 eventos concurrentes sin saturar el hilo principal del DOM.',
    metricas: 'Latencia < 15ms // Web Workers multihilo // 0 memory leaks',
    tags: ['React', 'WebSockets', 'Canvas 2D', 'TypeScript', 'Tailwind CSS'],
    demoUrl: '#',
    repoUrl: 'https://github.com',
    destacado: true,
  },
  {
    codigo: 'PROJ_03',
    titulo: 'Rust + WebAssembly Audio DSP Visualizer',
    subtitulo: 'Motor de análisis espectral y osciloscopio en tiempo real',
    descripcion: 'Visualizador de audio experimental que ejecuta algoritmos de Transformada Rápida de Fourier (FFT) compilados desde Rust a WebAssembly. Renderiza espectrogramas circulares y formas de onda con sincronización sub-milimétrica al ritmo de audio.',
    metricas: 'Pipeline Wasm sub-5ms // Web Audio API // Algoritmo FFT nativo',
    tags: ['Rust', 'WebAssembly', 'Web Audio API', 'TypeScript', 'Vite'],
    demoUrl: '#',
    repoUrl: 'https://github.com',
    destacado: false,
  },
  {
    codigo: 'PROJ_04',
    titulo: 'Headless E-Commerce & 3D Interactive Catalog',
    subtitulo: 'Comercio electrónico ultrarrápido con islas estáticas',
    descripcion: 'Tienda digital desacoplada construida sobre Astro 5 e hidratación parcial. Incluye visualizador de modelos 3D interactivo en el detalle de producto, carrito persistente en LocalStorage, pasarela de pago segura con Stripe y puntuación 100 en Google Lighthouse.',
    metricas: 'TTFB < 80ms // 100 Lighthouse // WCAG AA Compliance',
    tags: ['Astro 5', 'Stripe API', 'Three.js', 'PostgreSQL', 'Tailwind'],
    demoUrl: '#',
    repoUrl: 'https://github.com',
    destacado: false,
  },
];
---

<Layout title="Proyectos | Desarrollos 3D & Aplicaciones de Producción" description="Selección de proyectos de ingeniería de software, motores gráficos 3D en WebGL y arquitecturas web de alto impacto.">
  <main class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Top Grid: Text on the Left / 3D Assembly Crew on the Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-12">
      <div class="lg:col-span-7 space-y-4">
        <!-- Reticle badge -->
        <div class="inline-flex items-center gap-2 border border-amber-800/80 bg-amber-950/30 px-3 py-1 text-xs text-amber-400 font-bold crt-text-amber">
          <span>&gt;_ REGISTRO: CODE_REPOSITORY [0x04]</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-zinc-100 uppercase tracking-tight">
          PROYECTOS DESTACADOS
        </h1>

        <p class="text-sm sm:text-base text-zinc-300 leading-relaxed border-l-2 border-amber-700/80 pl-4 bg-[#121116]/70 py-2.5">
          Selección de aplicaciones en producción, herramientas gráficas en tiempo real y desarrollos técnicos construidos bajo rigurosos estándares de rendimiento.
        </p>

        <!-- Projects overview stats -->
        <div class="grid grid-cols-3 gap-2.5 pt-2 font-mono">
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-amber-500 crt-text-amber">4 CORE</span>
            <span class="text-[9px] text-zinc-400 uppercase">Proyectos Clave</span>
          </div>
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-emerald-400 crt-text-green">100% TS</span>
            <span class="text-[9px] text-zinc-400 uppercase">Tipado Estricto</span>
          </div>
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-amber-500 crt-text-amber">OPEN SOURCE</span>
            <span class="text-[9px] text-zinc-400 uppercase">Código Disponible</span>
          </div>
        </div>
      </div>

      <!-- Right Column: 3D Slot for Assembly Crew -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-full max-w-md aspect-square border border-[#451a03] bg-[#0c0c10]/85 p-4 relative shadow-2xl flex flex-col backdrop-blur-sm tech-card">
          <!-- Corner brackets -->
          <div class="tech-corner-tl"></div>
          <div class="tech-corner-tr"></div>
          <div class="tech-corner-bl"></div>
          <div class="tech-corner-br"></div>

          <div class="flex items-center justify-between text-[11px] text-amber-500 font-mono mb-2 border-b border-amber-900/40 pb-1.5">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
              <span class="crt-text-amber font-bold">CUADRILLA DE ENSAMBLAJE</span>
            </div>
            <span class="text-amber-400 font-bold animate-pulse text-[10px]">● EN CONSTRUCCIÓN</span>
          </div>

          <!-- 3D Anchor for Assembly Crew (on the RIGHT side) -->
          <div
            id="scene-anchor"
            data-rust-slot="builders"
            class="w-full flex-1 min-h-[300px] flex items-center justify-center cursor-grab select-none relative"
            title="Haz clic o arrastra para rotar la cuadrilla (emite sonido de soldadura eléctrica)"
          >
            <!-- 3D Builders Assembling Machine aligns here -->
          </div>

          <div class="flex items-center justify-between text-[10px] text-zinc-500 font-mono border-t border-amber-900/30 pt-1.5 mt-1">
            <span>UNIDAD DE CONSTRUCCIÓN // MAQUINARIA PESADA</span>
            <span class="text-amber-500 crt-text-amber font-bold">SONIDO: SOLDADURA</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {proyectos.map((p) => (
        <article class="border border-amber-900/50 bg-[#111116] p-6 flex flex-col justify-between relative tech-card">
          <div class="tech-corner-tl"></div>
          <div class="tech-corner-tr"></div>
          <div class="tech-corner-bl"></div>
          <div class="tech-corner-br"></div>

          <div>
            <div class="flex items-center justify-between gap-2 border-b border-amber-900/30 pb-2.5 mb-3">
              <div class="flex items-center gap-2">
                <span class="text-[10px] font-mono text-amber-500 font-bold bg-[#0c0c10] px-1.5 py-0.5 border border-amber-900/40">
                  {p.codigo}
                </span>
                <span class="text-[11px] font-mono text-zinc-400 font-semibold">{p.subtitulo}</span>
              </div>
              {p.destacado && (
                <span class="text-[9px] font-mono px-2 py-0.5 border border-amber-500/70 bg-amber-950/50 text-amber-300 font-bold crt-text-amber">
                  ★ DESTACADO
                </span>
              )}
            </div>

            <h2 class="text-base font-bold text-zinc-100 uppercase transition-colors mb-2.5 tracking-tight">
              {p.titulo}
            </h2>

            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-4">
              {p.descripcion}
            </p>

            <div class="bg-[#0c0c10] border border-amber-900/30 p-2.5 mb-4 text-[11px] font-mono text-emerald-400 flex items-center gap-2">
              <span class="text-amber-500 font-bold">&gt;&gt;</span>
              <span>{p.metricas}</span>
            </div>
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {p.tags.map((tag) => (
                <span class="text-[10px] font-mono px-2 py-0.5 border border-amber-900/40 bg-[#0d0c10] text-zinc-300 flex items-center gap-1">
                  <span class="text-amber-500">&bull;</span>
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-2.5 pt-3 border-t border-amber-900/30 text-xs">
              <a href={p.demoUrl} class="crt-btn text-[11px] py-1.5 px-4 flex items-center gap-1.5">
                <span>[ DEMO EN VIVO ]</span>
              </a>
              <a href={p.repoUrl} target="_blank" rel="noopener noreferrer" class="crt-btn crt-btn-secondary text-[11px] py-1.5 px-4 flex items-center gap-1.5">
                <span>[ CÓDIGO FUENTE &nearr; ]</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
