---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto | Hablemos de Ingeniería & Proyectos" description="Ponte en contacto directo para vacantes de ingeniería de software, proyectos freelance o consultoría técnica especializada.">
  <main class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Top Grid: 3D Rotary Phone on the LEFT / Header on the RIGHT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-12">
      
      <!-- Left Column: 3D Slot for Vintage Rotary Phone -->
      <div class="lg:col-span-5 flex justify-center order-2 lg:order-1">
        <div class="w-full max-w-md aspect-square border border-[#451a03] bg-[#0c0c10]/85 p-4 relative shadow-2xl flex flex-col backdrop-blur-sm tech-card">
          <!-- Corner brackets -->
          <div class="tech-corner-tl"></div>
          <div class="tech-corner-tr"></div>
          <div class="tech-corner-bl"></div>
          <div class="tech-corner-br"></div>

          <div class="flex items-center justify-between text-[11px] text-amber-500 font-mono mb-2 border-b border-amber-900/40 pb-1.5">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span class="crt-text-amber font-bold">TELÉFONO DE DISCO RETRO</span>
            </div>
            <span class="text-emerald-400 animate-pulse font-bold text-[10px]">● LÍNEA ABIERTA</span>
          </div>

          <!-- 3D Anchor for Rotary Telephone (on the LEFT side) -->
          <div
            id="scene-anchor"
            data-rust-slot="phone"
            class="w-full flex-1 min-h-[300px] flex items-center justify-center cursor-grab select-none relative"
            title="Haz clic o arrastra para rotar el teléfono (emite sonido de marcado con rueda telefónica)"
          >
            <!-- 3D Vintage Rotary Telephone aligns here -->
          </div>

          <div class="flex items-center justify-between text-[10px] text-zinc-500 font-mono border-t border-amber-900/30 pt-1.5 mt-1">
            <span>CANAL DIRECTO ANALÓGICO // 1965</span>
            <span class="text-amber-500 crt-text-amber font-bold">SONIDO: DISCO TELEFÓNICO</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Header Copy -->
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-4">
        <!-- Reticle badge -->
        <div class="inline-flex items-center gap-2 border border-amber-800/80 bg-amber-950/30 px-3 py-1 text-xs text-amber-400 font-bold crt-text-amber">
          <span>&gt;_ REGISTRO: COMMS_CHANNEL [0x05]</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-zinc-100 uppercase tracking-tight">
          CONTACTO & RECLUTAMIENTO
        </h1>

        <p class="text-sm sm:text-base text-zinc-300 leading-relaxed border-l-2 border-amber-700/80 pl-4 bg-[#121116]/70 py-2.5">
          ¿Tienes una posición abierta para un Ingeniero Senior, un proyecto interactivo 3D o necesitas una consultoría técnica en arquitectura y Core Web Vitals? Conversemos.
        </p>

        <!-- Availability Status Indicator -->
        <div class="border border-emerald-900/60 bg-emerald-950/20 p-3.5 text-xs font-mono flex items-center gap-3">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-emerald-300 font-bold crt-text-green">ESTADO: Disponible para contratación inmediata y proyectos selectos</span>
        </div>
      </div>
    </div>

    <!-- Contact Form & Direct Coordinates -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 mb-12">
      
      <!-- Direct Contact Details -->
      <div class="md:col-span-5 space-y-4">
        <div class="border border-amber-900/50 bg-[#111116] p-6 text-xs font-mono space-y-4 relative tech-card">
          <div class="tech-corner-tl"></div>
          <div class="tech-corner-tr"></div>
          <div class="tech-corner-bl"></div>
          <div class="tech-corner-br"></div>

          <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest crt-text-amber border-b border-amber-900/30 pb-2">
            // COORDENADAS DIRECTAS
          </h2>

          <div>
            <span class="text-zinc-500 block text-[10px] uppercase font-sans mb-1">Correo Electrónico Directo</span>
            <div class="flex items-center justify-between gap-2 p-2 bg-[#0c0c10] border border-amber-900/40">
              <a href="mailto:dev.contacto@ingenieria.tech" class="text-amber-400 font-bold hover:underline text-xs font-mono truncate">
                dev.contacto@ingenieria.tech
              </a>
              <button
                id="copy-email-btn"
                type="button"
                class="crt-btn text-[10px] py-1 px-2 select-none"
                title="Copiar correo al portapapeles"
              >
                <span id="copy-text">[ COPIAR ]</span>
              </button>
            </div>
          </div>

          <div>
            <span class="text-zinc-500 block text-[10px] uppercase font-sans mb-1">Ubicación / Zona Horaria</span>
            <p class="text-zinc-200 bg-[#0c0c10] p-2 border border-zinc-800">
              Remoto Global &bull; Huso horario UTC-5 (Flexible con Europa & EE.UU.)
            </p>
          </div>

          <div>
            <span class="text-zinc-500 block text-[10px] uppercase font-sans mb-2">Redes Profesionales & Código</span>
            <div class="flex flex-wrap gap-2 text-xs">
              <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="crt-btn crt-btn-secondary text-[11px] py-1.5 px-3">
                <span>[ LINKEDIN &nearr; ]</span>
              </a>
              <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="crt-btn crt-btn-secondary text-[11px] py-1.5 px-3">
                <span>[ GITHUB &nearr; ]</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Message Form -->
      <div class="md:col-span-7 border border-amber-900/50 bg-[#111116] p-6 relative tech-card">
        <div class="tech-corner-tl"></div>
        <div class="tech-corner-tr"></div>
        <div class="tech-corner-bl"></div>
        <div class="tech-corner-br"></div>

        <div class="flex items-center justify-between border-b border-amber-900/30 pb-2 mb-4">
          <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest crt-text-amber">// TERMINAL DE MENSAJERÍA DIRECTA</h2>
          <span class="text-zinc-500 font-mono text-[10px]">[ENCRIPTADO // TLS 1.3]</span>
        </div>

        <form id="contact-form" class="space-y-4 text-xs font-mono">
          <div>
            <label for="caller" class="block text-zinc-400 mb-1">TU NOMBRE / ORGANIZACIÓN</label>
            <input
              type="text"
              id="caller"
              name="caller"
              required
              placeholder="Ej. Ana García / Tech Studio"
              class="w-full border border-amber-900/50 bg-[#0c0c10] px-3.5 py-2.5 text-zinc-100 placeholder-zinc-600 focus:border-amber-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="freq" class="block text-zinc-400 mb-1">CORREO ELECTRÓNICO DE RETORNO</label>
            <input
              type="email"
              id="freq"
              name="freq"
              required
              placeholder="tu.correo@empresa.com"
              class="w-full border border-amber-900/50 bg-[#0c0c10] px-3.5 py-2.5 text-zinc-100 placeholder-zinc-600 focus:border-amber-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="payload" class="block text-zinc-400 mb-1">MENSAJE O PROPUESTA TÉCNICA</label>
            <textarea
              id="payload"
              name="payload"
              rows="4"
              required
              placeholder="Detalles sobre el rol laboral, proyecto interactivo 3D o consultoría..."
              class="w-full border border-amber-900/50 bg-[#0c0c10] px-3.5 py-2.5 text-zinc-100 placeholder-zinc-600 focus:border-amber-500 focus:outline-none resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="form-submit-btn"
            class="crt-btn text-xs w-full py-3.5 justify-center"
          >
            <span>[ &gt; TRANSMITIR MENSAJE // ENVIAR &lt; ]</span>
          </button>

          <div id="form-status" class="hidden border border-emerald-600/70 bg-emerald-950/40 p-3 text-emerald-400 text-xs font-mono">
            <span class="animate-pulse mr-2 font-bold">●</span>
            <span>MENSAJE TRANSMITIDO CON ÉXITO // TE RESPONDERÉ EN MENOS DE 24 HORAS.</span>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
  function setupContactInteractions() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    const submitBtn = document.getElementById('form-submit-btn');
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-text');

    if (copyBtn && copyText) {
      copyBtn.onclick = () => {
        navigator.clipboard.writeText('dev.contacto@ingenieria.tech').then(() => {
          copyText.textContent = '[ COPIADO ✓ ]';
          setTimeout(() => {
            if (copyText) copyText.textContent = '[ COPIAR ]';
          }, 2000);
        });
      };
    }

    if (form) {
      form.onsubmit = (e) => {
        e.preventDefault();
        if (submitBtn) {
          submitBtn.setAttribute('disabled', 'true');
          submitBtn.innerHTML = '<span>[ TRANSMITIENDO DATOS... ]</span>';
        }
        setTimeout(() => {
          if (status) status.classList.remove('hidden');
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.innerHTML = '<span>[ &gt; TRANSMITIR MENSAJE // ENVIAR &lt; ]</span>';
          }
          form.reset();
        }, 700);
      };
    }
  }

  document.addEventListener('astro:page-load', setupContactInteractions);
</script>
