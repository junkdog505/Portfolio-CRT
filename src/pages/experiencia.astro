---
import Layout from '../layouts/Layout.astro';

const experiencias = [
  {
    codigo: 'ROLE_01',
    puesto: 'Senior Frontend & Creative 3D Engineer',
    empresa: 'Digital Dynamics & Creative Studio',
    periodo: '2023 - Presente',
    tipo: 'Full-Time / Remoto Internacional',
    descripcion: 'Liderazgo técnico en el diseño e implementación de experiencias web inmersivas en 3D, micro-frontends de alta escala y aplicaciones web progresivas. Responsable del pipeline gráfico en Three.js / WebGL y de la arquitectura frontend con Astro y TypeScript.',
    logros: [
      'Reducción de un 45% en el tiempo de interacción inicial (TTI) y un 60% en el bundle size migrando SPAs monolíticas a Astro Islands.',
      'Desarrollo de un pipeline de shaders GLSL procedurales y renderizado 3D PBR optimizado a 60 FPS estables en más del 95% de dispositivos móviles.',
      'Supervisión y estandarización del Design System corporativo con Tailwind CSS y rigurosas pruebas de accesibilidad WCAG 2.1 AA.',
    ],
    tags: ['Three.js', 'WebGL', 'GLSL', 'Astro 5', 'TypeScript', 'Tailwind CSS', 'Node.js'],
  },
  {
    codigo: 'ROLE_02',
    puesto: 'Full-Stack Software Engineer',
    empresa: 'Nexus Cloud Analytics SaaS',
    periodo: '2021 - 2023',
    tipo: 'Full-Time / Remoto',
    descripcion: 'Diseño e ingeniería de paneles analíticos en tiempo real para visualización masiva de telemetría de servidores. Construcción de microservicios en Node.js, streaming de datos con WebSockets y componentes reactivos optimizados.',
    logros: [
      'Implementación de motor de renderizado de gráficos basado en Canvas 2D capaz de procesar 50,000 puntos de datos por segundo sin caídas de framerate.',
      'Diseño e integración de APIs RESTful y suscripciones GraphQL con persistencia en PostgreSQL y caché Redis de sub-10ms.',
      'Automatización de pipelines CI/CD con GitHub Actions y Docker, reduciendo el tiempo de despliegue a producción de 40 a 7 minutos.',
    ],
    tags: ['React', 'TypeScript', 'Node.js', 'WebSockets', 'GraphQL', 'PostgreSQL', 'Redis', 'Docker'],
  },
  {
    codigo: 'ROLE_03',
    puesto: 'Frontend & UI Systems Developer',
    empresa: 'InnovaTech Software Agency',
    periodo: '2020 - 2021',
    tipo: 'Presencial / Híbrido',
    descripcion: 'Desarrollo de interfaces de usuario para clientes empresariales, portales de comercio electrónico interactivos e integración con pasarelas de pago y CMSs headless.',
    logros: [
      'Despliegue y entrega exitosa de 12 proyectos web comerciales en tiempo y forma, cumpliendo auditorías de Core Web Vitals superiores a 95 puntos.',
      'Implementación de componentes accesibles y responsivos desde cero, garantizando paridad cross-browser en Chrome, Safari, Firefox y Edge.',
    ],
    tags: ['JavaScript (ESNext)', 'TypeScript', 'HTML5 Semántico', 'CSS Moderno', 'Vite', 'Git'],
  },
];
---

<Layout title="Experiencia | Trayectoria Laboral & Logros Técnicos" description="Historial profesional como ingeniero de software, roles desempeñados en empresas tecnológicas y logros en producción.">
  <main class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Top Grid: 3D Shovel on the LEFT / Header on the RIGHT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mb-12">
      
      <!-- Left Column: 3D Slot for Worn Shovel -->
      <div class="lg:col-span-5 flex justify-center order-2 lg:order-1">
        <div class="w-full max-w-md aspect-square border border-[#451a03] bg-[#0c0c10]/85 p-4 relative shadow-2xl flex flex-col backdrop-blur-sm tech-card">
          <!-- Corner brackets -->
          <div class="tech-corner-tl"></div>
          <div class="tech-corner-tr"></div>
          <div class="tech-corner-bl"></div>
          <div class="tech-corner-br"></div>

          <div class="flex items-center justify-between text-[11px] text-amber-500 font-mono mb-2 border-b border-amber-900/40 pb-1.5">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 22l10-10"></path>
                <path d="M9 5l7 7-2 2-7-7 2-2z"></path>
                <path d="M14 2l8 8-2 2-8-8 2-2z"></path>
              </svg>
              <span class="crt-text-amber font-bold">PALA INDUSTRIAL</span>
            </div>
            <span class="text-amber-400 animate-pulse font-bold text-[10px]">● TRAYECTORIA</span>
          </div>

          <!-- 3D Anchor for Worn Shovel (on the LEFT side) -->
          <div
            id="scene-anchor"
            data-rust-slot="shovel"
            class="w-full flex-1 min-h-[300px] flex items-center justify-center cursor-grab select-none relative"
            title="Haz clic o arrastra para rotar la pala (emite sonido de excavación en tierra)"
          >
            <!-- 3D Worn Shovel aligns here -->
          </div>

          <div class="flex items-center justify-between text-[10px] text-zinc-500 font-mono border-t border-amber-900/30 pt-1.5 mt-1">
            <span>HERRAMIENTA DE INGENIERÍA // ACERO FORJADO</span>
            <span class="text-amber-500 crt-text-amber font-bold">SONIDO: EXCAVACIÓN</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Header Copy -->
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-4">
        <!-- Reticle badge -->
        <div class="inline-flex items-center gap-2 border border-amber-800/80 bg-amber-950/30 px-3 py-1 text-xs text-amber-400 font-bold crt-text-amber">
          <span>&gt;_ REGISTRO: WORK_HISTORY [0x03]</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-zinc-100 uppercase tracking-tight">
          EXPERIENCIA LABORAL
        </h1>

        <p class="text-sm sm:text-base text-zinc-300 leading-relaxed border-l-2 border-amber-700/80 pl-4 bg-[#121116]/70 py-2.5">
          Trayectoria profesional comprobable liderando y ejecutando soluciones de software en empresas de tecnología, productos digitales SaaS y estudios creativos de alto impacto.
        </p>

        <!-- Professional impact metrics -->
        <div class="grid grid-cols-3 gap-2.5 pt-2 font-mono">
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-amber-500 crt-text-amber">-45% TTI</span>
            <span class="text-[9px] text-zinc-400 uppercase">Carga Inicial</span>
          </div>
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-emerald-400 crt-text-green">50K PTS/S</span>
            <span class="text-[9px] text-zinc-400 uppercase">Stream Telemetría</span>
          </div>
          <div class="border border-amber-900/40 bg-[#0c0c10]/90 p-2 text-center">
            <span class="block text-lg font-black text-amber-500 crt-text-amber">0 ERRORES</span>
            <span class="text-[9px] text-zinc-400 uppercase">En Producción</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Timeline of Experience -->
    <div class="space-y-6 mb-12">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-xs font-bold text-amber-500 uppercase tracking-widest crt-text-amber flex items-center gap-2">
          <span>[ // CRONOLOGÍA DE ROLES & RESPONSABILIDADES // ]</span>
        </h2>
        <span class="text-zinc-500 font-mono text-[10px]">[ORDEN CRONOLÓGICO INVERSO]</span>
      </div>

      {experiencias.map((item) => (
        <article class="border border-amber-900/50 bg-[#111116] p-6 relative tech-card">
          <div class="tech-corner-tl"></div>
          <div class="tech-corner-tr"></div>
          <div class="tech-corner-bl"></div>
          <div class="tech-corner-br"></div>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-amber-900/30 pb-3 mb-4">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[10px] font-mono text-amber-500 font-bold bg-[#0c0c10] px-1.5 py-0.5 border border-amber-900/40">
                  {item.codigo}
                </span>
                <span class="text-xs font-mono text-zinc-400 font-semibold">{item.empresa}</span>
                <span class="text-[10px] text-zinc-500 font-mono">• {item.tipo}</span>
              </div>
              <h2 class="text-base sm:text-lg font-bold text-zinc-100 uppercase tracking-tight">{item.puesto}</h2>
            </div>
            <span class="text-xs font-mono px-3 py-1 bg-amber-950/40 text-amber-400 border border-amber-800/60 w-fit self-start sm:self-auto font-bold">
              {item.periodo}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-4">
            {item.descripcion}
          </p>

          <div class="mb-4 bg-[#0c0c10] border border-amber-900/30 p-3.5 space-y-2">
            <p class="text-[10px] font-mono font-bold text-amber-500 uppercase tracking-widest crt-text-amber flex items-center gap-2">
              <span>// TELEMETRÍA DE IMPACTO & LOGROS CLAVE:</span>
            </p>
            <ul class="space-y-1.5 text-xs text-zinc-300 font-mono">
              {item.logros.map((logro, lIdx) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-400 font-bold select-none">[LOG_{String(lIdx + 1).padStart(2, '0')}]</span>
                  <span class="leading-normal font-sans text-xs text-zinc-300">{logro}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-amber-900/30">
            {item.tags.map((tag) => (
              <span class="text-[10px] font-mono px-2 py-0.5 border border-amber-900/40 bg-[#0d0c10] text-zinc-300 flex items-center gap-1">
                <span class="text-amber-500">&bull;</span>
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <!-- Recruitment & Contact CRT Bar -->
    <div class="mt-10 mb-12 border border-amber-900/60 bg-[#111116] p-6 flex flex-col sm:flex-row items-center justify-between gap-4 relative tech-card">
      <div class="tech-corner-tl"></div>
      <div class="tech-corner-tr"></div>
      <div class="tech-corner-bl"></div>
      <div class="tech-corner-br"></div>

      <div>
        <span class="text-xs text-amber-500 font-bold uppercase tracking-widest crt-text-amber">// ¿TIENES UN ROL O PROYECTO DESAFIANTE?</span>
        <p class="text-xs text-zinc-400 mt-1">Disponible para contratación full-time, consultorías de rendimiento Core Web Vitals o desarrollo 3D a medida.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/contacto" class="crt-btn text-xs py-2.5 px-6">
          <span>[ + ] INICIAR CONVERSACIÓN</span>
        </a>
      </div>
    </div>
  </main>
</Layout>
